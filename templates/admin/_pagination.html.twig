{% if page.pages > 1 %}
    <nav class="pagination" aria-label="Sayfalama">
        {% if page.hasPrevious %}<a rel="prev" href="{{ path(route, query|merge({page: page.page - 1})) }}">Önceki</a>{% endif %}
        <span>Sayfa {{ page.page }} / {{ page.pages }}</span>
        {% if page.hasNext %}<a rel="next" href="{{ path(route, query|merge({page: page.page + 1})) }}">Sonraki</a>{% endif %}
    </nav>
{% endif %}
