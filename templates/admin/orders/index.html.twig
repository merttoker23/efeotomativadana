{% extends 'admin/base.html.twig' %}{% block title %}Orders{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Commerce</p><h1>Orders</h1><form class="filter-bar" method="get"><label>Search <input type="search" name="q" value="{{ query }}"></label><label>Status <select name="state"><option value="">All</option>{% for option in ['placed','confirmed','cancelled','completed'] %}<option value="{{ option }}" {{ state == option ? 'selected' }}>{{ option|capitalize }}</option>{% endfor %}</select></label><button type="submit">Filter</button></form><p>{{ page.total }} orders</p><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th><th>Placed</th></tr></thead><tbody>{% for order in page.items %}<tr data-testid="order-row"><td><a href="{{ path('admin_order_show', {orderNumber: order.orderNumber}) }}">{{ order.orderNumber }}</a></td><td>{{ order.customerName }}<br><small>{{ order.customerEmail }}</small></td><td>{{ order.state.value }}</td><td>{{ order.grandTotal|storefront_money }}</td><td>{{ order.createdAt|date('Y-m-d H:i') }}</td></tr>{% else %}<tr><td colspan="5">No orders found.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_order_index', query: {q: query, state: state}} only %}</section>{% endblock %}
