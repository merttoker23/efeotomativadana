{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}Siparişler{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Satış yönetimi</p><h1>Siparişler</h1><form class="filter-bar" method="get"><label>Ara <input type="search" name="q" value="{{ query }}"></label><label>Durum <select name="state"><option value="">Tümü</option>{% for option in ['placed','confirmed','cancelled','completed'] %}<option value="{{ option }}" {{ state == option ? 'selected' }}>{{ ui.text(option) }}</option>{% endfor %}</select></label><button type="submit">Filtrele</button></form><p>{{ page.total }} sipariş</p><div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu"><table><thead><tr><th scope="col">Sipariş</th><th scope="col">Müşteri</th><th scope="col">Durum</th><th scope="col">Toplam</th><th scope="col">Sipariş tarihi</th></tr></thead><tbody>{% for order in page.items %}<tr data-testid="order-row"><td><a href="{{ path('admin_order_show', {orderNumber: order.orderNumber}) }}">{{ order.orderNumber }}</a></td><td>{{ order.customerName }}<br><small>{{ order.customerEmail }}</small></td><td>{{ ui.badge(order.state.value) }}</td><td>{{ order.grandTotal|storefront_money }}</td><td>{{ order.createdAt|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="5">Sipariş bulunamadı. Arama veya filtreleri değiştirin.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_order_index', query: {q: query, state: state}} only %}</section>{% endblock %}
