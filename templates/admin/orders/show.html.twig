{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}
{% if transitionForm is defined and transitionForm %}{% form_theme transitionForm 'admin/_form_theme.html.twig' %}{% endif %}
{% block title %}Sipariş {{ order.orderNumber }}{% endblock %}
{% block body %}
<section class="panel">
    <p class="eyebrow">Sipariş yönetimi</p>
    <h1>{{ order.orderNumber }}</h1>
    <dl class="detail-grid">
        <dt>Durum</dt><dd>{{ ui.text(order.state.value) }}</dd>
        <dt>Müşteri</dt><dd>{{ order.customerName }} · {{ order.customerEmail }}</dd>
        <dt>Toplam</dt><dd>{{ order.grandTotal|storefront_money }}</dd>
        <dt>Teslimat</dt><dd>{{ order.shippingOptionLabel }}</dd>
        <dt>Ödeme</dt><dd>{{ order.paymentOptionLabel }}</dd>
    </dl>
    <p><a href="{{ path('admin_payment_show', {orderNumber: order.orderNumber}) }}">Ödeme geçmişi</a></p>
    <p>
        {% if shipment is not null %}
            Kargo: <a href="{{ path('admin_shipment_show', {orderNumber: order.orderNumber}) }}">{{ tracking.stateLabel }}{% if tracking.hasTrackingNumber %} — {{ tracking.trackingNumber }}{% endif %}</a>
        {% elseif order.state.value == 'confirmed' %}
            <a href="{{ path('admin_shipment_show', {orderNumber: order.orderNumber}) }}">Bu sipariş için kargo oluştur</a>
        {% else %}
            <a href="{{ path('admin_shipment_show', {orderNumber: order.orderNumber}) }}">Kargo</a>
        {% endif %}
    </p>
    <div class="form-grid">
        <article class="subpanel">
            <h2>Teslimat adresi</h2>
            {% include 'admin/orders/_address.html.twig' with {address: shippingAddress} only %}
        </article>
        <article class="subpanel">
            <h2>Fatura adresi</h2>
            {% include 'admin/orders/_address.html.twig' with {address: billingAddress} only %}
        </article>
    </div>
    <h2>Ürünler</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu"><table><thead><tr><th scope="col">SKU</th><th scope="col">Ürün</th><th scope="col">Adet</th><th scope="col">Toplam</th></tr></thead><tbody>{% for item in order.items %}<tr><td>{{ item.sku }}</td><td>{{ item.productName }}</td><td>{{ item.quantity }}</td><td>{{ item.lineGross|storefront_money }}</td></tr>{% endfor %}</tbody></table></div>
    {% if transitionForm.nextState.vars.choices is not empty %}<h2>Durumu değiştir</h2><div class="form-errors">{{ form(transitionForm) }}</div>{% endif %}
    <h2>Durum geçmişi</h2>
    {% for change in history %}<article class="subpanel"><strong>{{ ui.text(change.fromState.value) }} → {{ ui.text(change.toState.value) }}</strong><p>{{ ui.text(change.reason) }}</p><small>{{ change.actorEmail }} · {{ change.changedAt|date('d.m.Y H:i:s') }}</small></article>{% else %}<p>Henüz durum değişikliği yok.</p>{% endfor %}
</section>
{% endblock %}
