{% use 'form_div_layout.html.twig' %}

{% block form_errors %}
    {% import 'admin/_labels.html.twig' as ui %}
    {% if errors|length > 0 %}
        <ul class="form-error-list" role="alert">
            {% for error in errors %}<li>{{ ui.text(error.messageTemplate|trans(error.messageParameters, 'validators', 'tr')) }}</li>{% endfor %}
        </ul>
    {% endif %}
{% endblock %}
