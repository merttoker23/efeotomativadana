{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}

{% block title %}Ödemeler{% endblock %}

{% block body %}
<section class="panel">
<h1>Ödemeler</h1>
<p>Sipariş ödemelerini, tahsilatları ve para iadelerini takip edin. Ödeme işlemleri sipariş geçmişinden ayrı kaydedilir.</p>

<form method="get" action="{{ path('admin_payment_index') }}" class="admin-filters">
    <label for="payment-query">Ara<input type="search" id="payment-query" name="q" value="{{ query }}" placeholder="Sipariş no, müşteri e-postası veya sağlayıcı referansı"></label>
    <label for="payment-state">Durum<select id="payment-state" name="state">
        <option value="">Tümü</option>
        {% for state in states %}
            <option value="{{ state.value }}"{{ state.value == state_filter ? ' selected' : '' }}>{{ ui.text(state.value) }}</option>
        {% endfor %}
    </select></label>
    <button type="submit">Filtrele</button>
</form>

<div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
    <table class="admin-table">
    <caption class="visually-hidden">Ödemeler</caption>
    <thead>
        <tr>
            <th scope="col">Sipariş</th>
            <th scope="col">Müşteri</th>
            <th scope="col">Durum</th>
            <th scope="col">Sağlayıcı</th>
            <th scope="col">Referans</th>
            <th scope="col">Tutar</th>
            <th scope="col">Tahsil edilen</th>
            <th scope="col">İade edilen</th>
            <th scope="col">Güncellenen</th>
        </tr>
    </thead>
    <tbody>
        {% for payment in page.items %}
            <tr>
                <td><a href="{{ path('admin_payment_show', {orderNumber: payment.order.orderNumber}) }}">{{ payment.order.orderNumber }}</a></td>
                <td>{{ payment.order.customerEmail }}</td>
                <td><span class="admin-badge" data-status="{{ payment.state.value }}">{{ ui.text(payment.state.value) }}</span></td>
                <td>{{ payment.providerKey }}</td>
                <td>{{ payment.latestAttempt ? payment.latestAttempt.providerReference : '—' }}</td>
                <td>{{ payment.amount|storefront_money }}</td>
                <td>{{ payment.capturedAmount|storefront_money }}</td>
                <td>{{ payment.refundedAmount|storefront_money }}</td>
                <td>{{ payment.updatedAt|date('d.m.Y H:i') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="9">Gösterilecek ödeme kaydı yok.</td></tr>
        {% endfor %}
    </tbody>
    </table>
</div>

{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_payment_index', query: {q: query, state: state_filter}} %}
</section>
{% endblock %}
