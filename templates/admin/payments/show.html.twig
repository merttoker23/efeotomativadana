{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}
{% if cancelForm is defined and cancelForm %}{% form_theme cancelForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if retryForm is defined and retryForm %}{% form_theme retryForm 'admin/_form_theme.html.twig' %}{% endif %}

{% block title %}Ödeme {{ order.orderNumber }}{% endblock %}

{% block body %}
<section class="panel">
<h1>Ödeme</h1>

<dl class="admin-summary">
    <dt>Sipariş</dt>
    <dd><a href="{{ path('admin_order_show', {orderNumber: order.orderNumber}) }}">{{ order.orderNumber }}</a></dd>
    <dt>Müşteri</dt>
    <dd>{{ order.customerEmail }} — {{ order.customerName }}</dd>
    <dt>Durum</dt>
    <dd><span class="admin-badge" data-status="{{ payment.state.value }}">{{ ui.text(payment.state.value) }}</span></dd>
    <dt>Yöntem</dt>
    <dd>{{ payment.methodLabel }} ({{ payment.methodKey }})</dd>
    <dt>Sağlayıcı</dt>
    <dd>{{ payment.providerKey }}</dd>
    <dt>Tutar</dt>
    <dd>{{ payment.amount|storefront_money }} <small>({{ payment.amount.minorAmount }} alt birim)</small></dd>
    <dt>Tahsil edilen</dt>
    <dd>{{ payment.capturedAmount|storefront_money }} <small>({{ payment.capturedAmount.minorAmount }} alt birim)</small></dd>
    <dt>İade edilen</dt>
    <dd>{{ payment.refundedAmount|storefront_money }} <small>({{ payment.refundedAmount.minorAmount }} alt birim)</small></dd>
    <dt>İade edilebilir</dt>
    <dd>{{ payment.refundableAmount|storefront_money }} <small>({{ payment.refundableAmount.minorAmount }} alt birim)</small></dd>
    <dt>Sipariş durumu</dt>
    <dd>{{ ui.text(order.state.value) }}</dd>
</dl>

{% if payment.failure %}
    <h2>Son hata</h2>
    <p class="alert alert-error" role="alert">
        <strong>{{ payment.failure.code }}</strong>
        {% if payment.failure.message %}<br>{{ payment.failure.message }}{% endif %}
    </p>
{% endif %}

<h2>Ödeme denemeleri</h2>
<div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
    <table class="admin-table">
    <caption class="visually-hidden">Ödeme denemeleri</caption>
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Durum</th>
            <th scope="col">Sağlayıcı referansı</th>
            <th scope="col">Tutar</th>
            <th scope="col">Başlangıç</th>
            <th scope="col">Tahsil edilen</th>
            <th scope="col">Hata</th>
        </tr>
    </thead>
    <tbody>
        {% for attempt in attempts %}
            <tr>
                <td>{{ attempt.sequence }}</td>
                <td>{{ ui.badge(attempt.state.value) }}</td>
                <td>{{ attempt.providerReference ?? '—' }}</td>
                <td>{{ attempt.amount|storefront_money }}</td>
                <td>{{ attempt.createdAt|date('d.m.Y H:i') }}</td>
                <td>{{ attempt.succeededAt ? attempt.succeededAt|date('d.m.Y H:i') : '—' }}</td>
                <td>{{ attempt.failure ? attempt.failure.code : '—' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="7">Henüz ödeme denemesi yok.</td></tr>
        {% endfor %}
    </tbody>
    </table>
</div>

<h2>Para iadeleri</h2>
<div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
    <table class="admin-table">
    <caption class="visually-hidden">Para iadeleri</caption>
    <thead>
        <tr>
            <th scope="col">Durum</th>
            <th scope="col">Tutar</th>
            <th scope="col">Sağlayıcı referansı</th>
            <th scope="col">Gerekçe</th>
            <th scope="col">Kayıt tarihi</th>
        </tr>
    </thead>
    <tbody>
        {% for refund in refunds %}
            <tr>
                <td>{{ ui.badge(refund.state.value) }}</td>
                <td>{{ refund.amount|storefront_money }}</td>
                <td>{{ refund.providerReference }}</td>
                <td>{{ refund.reason }}</td>
                <td>{{ refund.createdAt|date('d.m.Y H:i') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5">Henüz para iadesi yok.</td></tr>
        {% endfor %}
    </tbody>
    </table>
</div>

<h2>Ödeme geçmişi</h2>
<p>Sağlayıcıdan gelen ödeme kayıtları. Sipariş hareketlerini
   <a href="{{ path('admin_order_show', {orderNumber: order.orderNumber}) }}">sipariş sayfasında görebilirsiniz</a>.</p>
<div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
    <table class="admin-table">
    <caption class="visually-hidden">Ödeme geçmişi</caption>
    <thead>
        <tr>
            <th scope="col">Durum</th>
            <th scope="col">Kaynak</th>
            <th scope="col">Deneme</th>
            <th scope="col">Açıklama</th>
            <th scope="col">Tarih</th>
        </tr>
    </thead>
    <tbody>
        {% for event in events %}
            <tr>
                <td>{{ ui.badge(event.toState.value) }}</td>
                <td>{{ ui.text(event.source) }}</td>
                <td>{{ event.attemptSequence ?? '—' }}</td>
                <td>{{ ui.text(event.detail ?? '—') }}</td>
                <td>{{ event.occurredAt|date('d.m.Y H:i') }}</td>
            </tr>
        {% endfor %}
    </tbody>
    </table>
</div>

<h2>İşlemler</h2>
{% if isActionable %}
    <p>Henüz tahsilat yapılmadı. Ödemeyi yeniden başlatabilir veya iptal edebilirsiniz.</p>
    {{ form(retryForm) }}

    {{ form_start(cancelForm) }}
        {{ form_widget(cancelForm) }}
    {{ form_end(cancelForm) }}
{% else %}
    <p>
        Tahsil edilmiş ödeme yeniden başlatılamaz veya iptal edilemez. Para iadesi için ödeme sağlayıcısının iade sürecini kullanın.
    </p>
{% endif %}
</section>
{% endblock %}
