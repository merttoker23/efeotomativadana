{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% block title %}{{ product ? 'Ürünü düzenle' : 'Yeni ürün' }}{% endblock %}
{% block body %}
<section class="panel"><p class="eyebrow">Katalog yönetimi</p><h1>{{ product ? 'Ürünü düzenle' : 'Yeni ürün' }}</h1>
<div class="form-errors">{{ form_start(form) }}{{ form_errors(form) }}
<fieldset><legend>Ürün bilgileri ve yayın</legend>{{ form_row(form.sku) }}{{ form_row(form.name) }}{{ form_row(form.slug) }}{{ form_row(form.description) }}{{ form_row(form.published) }}{{ form_row(form.brand) }}{{ form_row(form.categories) }}</fieldset>
<fieldset><legend>Ürün kodları ve görseller</legend>{{ form_row(form.manufacturerCode) }}{{ form_row(form.oemCodes) }}{{ form_row(form.referenceCodes) }}{{ form_row(form.imagePaths) }}</fieldset>
<fieldset><legend>Fiyat ve vergi</legend><div class="form-grid">{{ form_row(form.baseMinorAmount) }}{{ form_row(form.currency) }}{{ form_row(form.taxCategory) }}{{ form_row(form.taxRateBasisPoints) }}{{ form_row(form.saleMinorAmount) }}{{ form_row(form.saleStartsAt) }}{{ form_row(form.saleEndsAt) }}</div></fieldset>
<fieldset><legend>Stok</legend><div class="form-grid">{{ form_row(form.quantity) }}{{ form_row(form.availableForSale) }}</div></fieldset>
{{ form_row(form.save) }}{{ form_end(form) }}</div>
{% if product %}<form class="danger-zone" method="post" action="{{ path('admin_catalog_product_delete', {id: product.id}) }}" data-controller="confirm" data-confirm-message-value="Bu ürün silinsin mi?" data-action="confirm#submit"><input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}"><button class="danger-button" type="submit">Ürünü sil</button></form>{% endif %}
</section>
{% endblock %}
