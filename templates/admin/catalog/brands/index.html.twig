{% extends 'admin/base.html.twig' %}{% block title %}Brands{% endblock %}{% block body %}<section class="panel"><div class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Brands</h1></div><a class="button-link" href="{{ path('admin_catalog_brand_new') }}">New brand</a></div><form class="filter-bar" method="get"><label>Search <input type="search" name="q" value="{{ query }}"></label><button type="submit">Filter</button></form><p>{{ page.total }} brands</p><div class="table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th>Status</th><th></th></tr></thead><tbody>{% for brand in page.items %}<tr><td>{{ brand.name }}</td><td>{{ brand.slug }}</td><td>{{ brand.publicationStatus.value }}</td><td><a href="{{ path('admin_catalog_brand_edit', {id: brand.id}) }}">Edit</a></td></tr>{% else %}<tr><td colspan="4">No brands found.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_catalog_brand_index', query: {q: query}} only %}</section>{% endblock %}
