{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}Markalar{% endblock %}{% block body %}<section class="panel"><div class="page-heading"><div><p class="eyebrow">Katalog</p><h1>Markalar</h1></div><a class="button-link" href="{{ path('admin_catalog_brand_new') }}">Yeni marka</a></div><form class="filter-bar" method="get"><label>Ara <input type="search" name="q" value="{{ query }}"></label><button type="submit">Filtrele</button></form><p>{{ page.total }} marka</p><div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu"><table><thead><tr><th scope="col">Ad</th><th scope="col">URL kısa adı (slug)</th><th scope="col">Durum</th><th scope="col"><span class="visually-hidden">İşlemler</span></th></tr></thead><tbody>{% for brand in page.items %}<tr><td>{{ brand.name }}</td><td>{{ brand.slug }}</td><td>{{ ui.badge(brand.publicationStatus.value) }}</td><td><a href="{{ path('admin_catalog_brand_edit', {id: brand.id}) }}">Düzenle</a></td></tr>{% else %}<tr><td colspan="4">Marka bulunamadı. Aramayı değiştirin veya yeni marka ekleyin.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_catalog_brand_index', query: {q: query}} only %}</section>{% endblock %}
