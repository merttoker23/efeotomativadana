{% extends 'admin/base.html.twig' %}{% block title %}{{ brand ? 'Edit brand' : 'New brand' }}{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Catalog</p><h1>{{ brand ? 'Edit brand' : 'New brand' }}</h1><div class="form-errors">{{ form(form) }}</div>{% if brand %}<form class="danger-zone" method="post" action="{{ path('admin_catalog_brand_delete', {id: brand.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_brand_' ~ brand.id) }}"><button class="danger-button" type="submit">Delete brand</button></form>{% endif %}</section>{% endblock %}
