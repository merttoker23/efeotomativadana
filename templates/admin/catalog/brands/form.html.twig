{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}{{ brand ? 'Markayı düzenle' : 'Yeni marka' }}{% endblock %}

{% block body %}
    <section class="panel">
        <p class="eyebrow">Katalog</p>
        <h1>{{ brand ? 'Markayı düzenle' : 'Yeni marka' }}</h1>
        {% if brand %}
            <p>Mevcut marka logosu</p>
            <img class="cms-image-preview brand-logo-preview" src="{{ brand_logo_url(brand.id) }}" alt="{{ brand.name }} logosu"
                 width="240" height="120" data-fallback-src="{{ product_image_url(null) }}"
                 onerror="this.onerror = null; this.src = this.dataset.fallbackSrc;">
        {% endif %}
        <div class="form-errors">{{ form(form) }}</div>
        {% if brand %}
            <form class="danger-zone" data-controller="confirm" data-confirm-message-value="Bu marka silinsin mi?" data-action="confirm#submit" method="post" action="{{ path('admin_catalog_brand_delete', {id: brand.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_brand_' ~ brand.id) }}">
                <button class="danger-button" type="submit">Markayı sil</button>
            </form>
        {% endif %}
    </section>
{% endblock %}
