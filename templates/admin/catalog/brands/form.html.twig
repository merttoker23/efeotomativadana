{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}{% block title %}{{ brand ? 'Markayı düzenle' : 'Yeni marka' }}{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Katalog</p><h1>{{ brand ? 'Markayı düzenle' : 'Yeni marka' }}</h1><div class="form-errors">{{ form(form) }}</div>{% if brand %}<form class="danger-zone" data-controller="confirm" data-confirm-message-value="Bu marka silinsin mi?" data-action="confirm#submit" method="post" action="{{ path('admin_catalog_brand_delete', {id: brand.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_brand_' ~ brand.id) }}"><button class="danger-button" type="submit">Markayı sil</button></form>{% endif %}</section>{% endblock %}
