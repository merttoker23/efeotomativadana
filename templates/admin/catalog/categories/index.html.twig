{% extends 'admin/base.html.twig' %}{% block title %}Categories{% endblock %}{% block body %}<section class="panel"><div class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Categories</h1></div><a class="button-link" href="{{ path('admin_catalog_category_new') }}">New category</a></div><form class="filter-bar" method="get"><label>Search <input type="search" name="q" value="{{ query }}"></label><button type="submit">Filter</button></form><p>{{ page.total }} categories</p><div class="table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th>Parent</th><th>Status</th><th></th></tr></thead><tbody>{% for category in page.items %}<tr><td>{{ category.name }}</td><td>{{ category.slug }}</td><td>{{ category.parent ? category.parent.name : '—' }}</td><td>{{ category.publicationStatus.value }}</td><td><a href="{{ path('admin_catalog_category_edit', {id: category.id}) }}">Edit</a></td></tr>{% else %}<tr><td colspan="5">No categories found.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_catalog_category_index', query: {q: query}} only %}</section>{% endblock %}
