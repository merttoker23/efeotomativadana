{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}Kategoriler{% endblock %}{% block body %}<section class="panel"><div class="page-heading"><div><p class="eyebrow">Katalog</p><h1>Kategoriler</h1></div><a class="button-link" href="{{ path('admin_catalog_category_new') }}">Yeni kategori</a></div><form class="filter-bar" method="get"><label>Ara <input type="search" name="q" value="{{ query }}"></label><button type="submit">Filtrele</button></form><p>{{ page.total }} kategori</p><div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu"><table><thead><tr><th scope="col">Ad</th><th scope="col">URL kısa adı (slug)</th><th scope="col">Üst kategori</th><th scope="col">Durum</th><th scope="col"><span class="visually-hidden">İşlemler</span></th></tr></thead><tbody>{% for category in page.items %}<tr><td>{{ category.name }}</td><td>{{ category.slug }}</td><td>{{ category.parent ? category.parent.name : '—' }}</td><td>{{ ui.badge(category.publicationStatus.value) }}</td><td><a href="{{ path('admin_catalog_category_edit', {id: category.id}) }}">Düzenle</a></td></tr>{% else %}<tr><td colspan="5">Kategori bulunamadı. Aramayı değiştirin veya yeni kategori ekleyin.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_catalog_category_index', query: {q: query}} only %}</section>{% endblock %}
