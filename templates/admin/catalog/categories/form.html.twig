{% extends 'admin/base.html.twig' %}{% block title %}{{ category ? 'Edit category' : 'New category' }}{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Catalog</p><h1>{{ category ? 'Edit category' : 'New category' }}</h1><div class="form-errors">{{ form(form) }}</div>{% if category %}<form class="danger-zone" method="post" action="{{ path('admin_catalog_category_delete', {id: category.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}"><button class="danger-button" type="submit">Delete category</button></form>{% endif %}</section>{% endblock %}
