{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}{% block title %}{{ category ? 'Kategoriyi düzenle' : 'Yeni kategori' }}{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Katalog</p><h1>{{ category ? 'Kategoriyi düzenle' : 'Yeni kategori' }}</h1><div class="form-errors">{{ form(form) }}</div>{% if category %}<form class="danger-zone" data-controller="confirm" data-confirm-message-value="Bu kategori silinsin mi?" data-action="confirm#submit" method="post" action="{{ path('admin_catalog_category_delete', {id: category.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}"><button class="danger-button" type="submit">Kategoriyi sil</button></form>{% endif %}</section>{% endblock %}
