{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Mağaza Ayarları{% endblock %}

{% block body %}
    <section class="panel">
        <p class="eyebrow">Yapılandırma</p>
        <h1>Mağaza Ayarları</h1>
        <p>Mağazanın genel bilgilerini, özelliklerini ve görünümünü düzenleyin.</p>

        <div class="form-errors">
            {{ form_start(form) }}
                {{ form_errors(form) }}

                <fieldset>
                    <legend>Mağaza</legend>
                    {{ form_row(form.storeName) }}
                    {{ form_row(form.contactEmail) }}
                    {# İl/ilçe tek bir denetimdir: ilçe, seçilen ile ait olmayan seçenekler gizlenerek
                       aynı anda daralır. Katalog tek istekte sayfaya gömülür. #}
                    <div class="form-grid" data-controller="store-address"
                         data-store-address-districts-value="{{ store_district_catalog|json_encode|escape('html_attr') }}">
                        {{ form_row(form.city) }}
                        {{ form_row(form.district) }}
                    </div>
                    {{ form_row(form.phone) }}
                    {{ form_row(form.defaultLocale) }}
                    {{ form_row(form.defaultTaxRate) }}
                </fieldset>

                <fieldset>
                    <legend>Özellikler</legend>
                    {{ form_row(form.b2bEnabled) }}
                    {{ form_row(form.b2bProvider) }}
                    {{ form_row(form.loyaltyEnabled) }}
                    {{ form_row(form.loyaltyEarnPercentage) }}
                </fieldset>

                <fieldset>
                    <legend>Google Analytics</legend>
                    {{ form_row(form.ga4MeasurementId) }}
                </fieldset>

                <fieldset>
                    <legend>Storefront Renkleri</legend>
                    {{ form_row(form.storefrontNotice) }}
                    {{ form_row(form.storefrontNavy) }}
                    {{ form_row(form.storefrontNavyLight) }}
                    {{ form_row(form.storefrontYellow) }}
                    {{ form_row(form.storefrontBody) }}
                    {{ form_row(form.storefrontCard) }}
                    {{ form_row(form.storefrontInk) }}
                    {{ form_row(form.storefrontMuted) }}
                    {{ form_row(form.storefrontLine) }}
                </fieldset>

                {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
