{% import 'admin/_labels.html.twig' as ui %}
<div class="table-wrap" tabindex="0" role="region" aria-label="Ödül kayıtları">
<table><caption>Ödül geçmişi</caption><thead><tr><th scope="col">Tarih</th><th scope="col">Müşteri</th><th scope="col">Sipariş</th><th scope="col">Tür</th><th scope="col">Puan</th><th scope="col">Gerekçe / işlemi yapan</th></tr></thead><tbody>
{% for entry in page.items %}<tr><td>{{ entry.createdAt|date('d.m.Y H:i') }}</td><td><a href="{{ path('admin_reward_customer', {customerId: entry.customer.id}) }}">{{ entry.customer.userIdentifier }}</a></td><td>{{ entry.order ? entry.order.orderNumber : '—' }}</td><td>{{ ui.text(entry.kind.value) }}</td><td>{{ entry.points }}</td><td>{{ entry.reason }}{% if entry.actorEmail %}<br>{{ entry.actorEmail }}{% endif %}</td></tr>{% else %}<tr><td colspan="6">Henüz ödül kaydı yok.</td></tr>{% endfor %}
</tbody></table></div>
