{% extends 'admin/base.html.twig' %}{% block title %}CMS media{% endblock %}{% block body %}<section class="panel"><h1>CMS media</h1><p>Upload a JPEG, PNG or WebP image (maximum 5 MB and 6000 × 6000 pixels), then copy its path into a banner or hero section.</p>{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}{% if path %}<p role="status">Uploaded image path: <code>{{ path }}</code></p><img src="{{ media_url(path) }}" alt="Uploaded preview" style="max-width:300px;max-height:180px">{% endif %}<form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('cms_media_upload') }}"><label for="image">Image file</label><input id="image" type="file" name="image" accept="image/jpeg,image/png,image/webp" required><button type="submit">Upload image</button></form></section>{% endblock %}
