{% extends 'admin/base.html.twig' %}

{% block title %}Homepage sections{% endblock %}

{% block body %}
<h1>Homepage sections</h1>
<p class="help-text">The storefront follows the theme's own composition: the category menu, hero slider and top sellers share the upper row, and the testimonials and blog feed share the closing row. A module's type decides where it sits, so there is nothing to reorder — a second product carousel becomes the next full-width block, and new sections are added below the ones already published.</p>

{% if sections is empty %}
    <section class="panel">
        <p>The homepage has no sections yet, so visitors see the default welcome panel. Add the theme's first block below.</p>
        <a class="button-link" href="{{ path('admin_cms_home_new', {type: 'hero_slider'}) }}">Add a hero slider</a>
    </section>
{% else %}
    <div class="admin-table-wrap">
        <table class="admin-table">
            <caption>Homepage sections</caption>
            <thead>
                <tr><th scope="col">Title</th><th scope="col">Type</th><th scope="col">State</th><th scope="col">Actions</th></tr>
            </thead>
            <tbody>
                {% for section in sections %}
                    <tr>
                        <td>{{ section.title }}</td>
                        <td>{{ section.type.label }}</td>
                        <td>
                            <form method="post" action="{{ path('admin_cms_home_toggle', {id: section.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}">
                                <button type="submit">{{ section.enabled ? 'Disable' : 'Enable' }}</button>
                            </form>
                        </td>
                        <td>
                            <a href="{{ path('admin_cms_home_edit', {id: section.id}) }}">Edit with forms</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

<section class="subpanel">
    <h3>Images</h3>
    <p>
        Hero and banner images are uploaded and previewed on the section form itself. If you need a
        banner image loaded before its section exists,
        <a href="{{ path('admin_cms_media_index') }}">upload it to the media library</a> and it will be
        waiting in the form's picker.
    </p>
</section>

<p><a class="button-link" href="{{ path('admin_cms_home_new', {type: 'hero_slider'}) }}">Add a section</a></p>
{% endblock %}
