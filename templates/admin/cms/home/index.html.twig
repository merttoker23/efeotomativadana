{% extends 'admin/base.html.twig' %}

{% block title %}Ana sayfa bölümleri{% endblock %}

{% block body %}
<section class="panel">
<h1>Ana sayfa bölümleri</h1>
<p class="help-text">Ana sayfa bölümlerini düzenleyin ve yayın durumlarını yönetin. Bölümün türü sayfadaki konumunu belirler; yeni bölümler mevcut yayın sırasına eklenir.</p>

{% if sections is empty %}
    <section class="panel">
        <p>Henüz ana sayfa bölümü yok. İlk görsel alanını ekleyerek başlayın.</p>
        <a class="button-link" href="{{ path('admin_cms_home_new', {type: 'hero_slider'}) }}">Ana görsel alanı ekle</a>
    </section>
{% else %}
    <div class="admin-table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
        <table class="admin-table">
            <caption>Ana sayfa bölümleri</caption>
            <thead>
                <tr><th scope="col">Başlık</th><th scope="col">Tür</th><th scope="col">Durum</th><th scope="col">İşlemler</th></tr>
            </thead>
            <tbody>
                {% for section in sections %}
                    <tr>
                        <td>{{ section.title }}</td>
                        <td>{{ section.type.label }}</td>
                        <td>
                            <form method="post" action="{{ path('admin_cms_home_toggle', {id: section.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}">
                                <button class="cms-section-action" type="submit">{{ section.enabled ? 'Pasifleştir' : 'Aktifleştir' }}</button>
                            </form>
                        </td>
                        <td>
                            <a class="button-link cms-section-action" href="{{ path('admin_cms_home_edit', {id: section.id}) }}">Bölümü düzenle</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

<section class="subpanel">
    <h3>Görseller</h3>
    <p>
        Bölüm görsellerini ilgili formda yükleyip önizleyebilirsiniz. Bir görseli önceden hazırlamak için
        <a href="{{ path('admin_cms_media_index') }}">medya kütüphanesine yükleyin</a> ; görsel daha sonra bölüm formunda seçilebilir.
    </p>
</section>

<p><a class="button-link" href="{{ path('admin_cms_home_new', {type: 'hero_slider'}) }}">Bölüm ekle</a></p>
</section>
{% endblock %}
