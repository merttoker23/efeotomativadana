{% extends 'admin/base.html.twig' %}{% block title %}Homepage sections{% endblock %}{% block body %}<section class="panel"><h1>Homepage sections</h1><p>Published sections render in this order. References to unpublished catalog items stay hidden.</p><p><a class="button" href="{{ path('admin_cms_home_new') }}">Add section</a> <a href="{{ path('admin_cms_media_index') }}">Upload banner image</a></p><div class="admin-table-wrap"><table><thead><tr><th>Order</th><th>Type</th><th>Title</th><th>Status</th><th>Actions</th></tr></thead><tbody>{% for section in sections %}<tr><td>{{ loop.index }}</td><td>{{ section.type.value }}</td><td><a href="{{ path('admin_cms_home_edit', {id: section.id}) }}">{{ section.title }}</a></td><td>{{ section.enabled ? 'Enabled' : 'Disabled' }}</td><td><form method="post" action="{{ path('admin_cms_home_toggle', {id: section.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}"><button type="submit">{{ section.enabled ? 'Disable' : 'Enable' }}</button></form><form method="post" action="{{ path('admin_cms_home_move', {id: section.id, direction: 'up'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}"><button type="submit" aria-label="Move {{ section.title }} up">↑</button></form><form method="post" action="{{ path('admin_cms_home_move', {id: section.id, direction: 'down'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}"><button type="submit" aria-label="Move {{ section.title }} down">↓</button></form></td></tr>{% else %}<tr><td colspan="5">No sections yet. The storefront shows its default welcome panel.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
