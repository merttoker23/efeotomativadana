{# The repeatable part of a section: slides, banners, features, quotes, marquee items or tabs.

   A blank prototype is rendered inside a `<template>`, which a browser neither displays nor
   submits. It exists so the "add row" button can produce an empty row without a round trip, and
   because it is never a control, nothing it contains is ever read by the server. Without
   scripting the same button is a submit that asks the server for another blank row. #}
{% set rows = type.rowName() %}
<div class="cms-rows"
     data-controller="home-section-form"
     data-home-section-form-prefix-value="{{ rows }}"
     data-home-section-form-target="rows">
    <input type="hidden" name="{{ rows }}_count" value="{{ items|length }}" max="20" data-home-section-form-target="count">

    {% for item in items %}
        <fieldset class="cms-row" data-index="{{ loop.index0 }}" data-home-section-form-target="row">
            <legend>{{ loop.index }}. satır</legend>
            {% for field in type.rowFields %}
                {% set name = rows ~ '_' ~ loop.parent.loop.index0 ~ '_' ~ field %}
                {% set value = item[field]|default('') %}
                {% if field in ['image', 'mobileImage'] %}
                    {% if 'hero_slider' == type.value %}<p><strong>{{ type.fieldLabels()[field] }}</strong></p>{% endif %}
                    {% include 'admin/cms/home/_image.html.twig' with {name: name, current: value, library: library, mobile: 'mobileImage' == field} only %}
                    {% if 'mobileImage' == field %}<p class="help-text">680px ve altında kullanılır. Görsel seçilmezse mağazanın placeholder görseli gösterilir.</p>{% endif %}
                {% elseif type.isLinkField(field) %}
                    {% include 'admin/cms/home/_link.html.twig' with {name: name, value: value} only %}
                {% elseif type.isSourceField(field) %}
                    {# Where this row's products come from. Only the manual source has products to
                       pick, so the four options name what each one will actually show and the picker
                       below appears for that one alone. #}
                    <div class="cms-field">
                        <label for="{{ name }}">{{ type.fieldLabels()[field] }}</label>
                        <select id="{{ name }}" name="{{ name }}">
                            {% for choice in type.sourceChoices %}
                                <option value="{{ choice.value }}"{{ choice.value == value ? ' selected' : '' }}>{{ choice.label }}</option>
                            {% endfor %}
                        </select>
                        <p class="help-text">Bu kaynak seçiliyken ürünler mağazadaki gerçek verilerden sıralanır. Yalnızca “Öne Çıkanlar” seçilirse aşağıdaki listeden manuel ürün seçebilirsiniz.</p>
                    </div>
                {% else %}
                    <div class="cms-field">
                        <label for="{{ name }}">{{ type.fieldLabels()[field]|default(field) }}</label>
                        {% if 'text' == field %}
                            <textarea id="{{ name }}" name="{{ name }}" rows="3" maxlength="500">{{ value }}</textarea>
                        {% else %}
                            <input id="{{ name }}" type="text" name="{{ name }}" value="{{ value }}" maxlength="500">
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            {% if type.selectionPerRow and (item.source|default('featured') == 'featured') %}
                {% include 'admin/cms/home/_picker.html.twig' with {
                    kind: type.selection(),
                    prefix: rows ~ '_' ~ loop.index0 ~ '_p',
                    target: rows ~ '_' ~ loop.index0 ~ '_p',
                    slugs: item.slugs|default([]),
                    query: query,
                    options: options,
                    labels: labels,
                } only %}
            {% endif %}
            {% if type.value == 'announcement_bar' %}
                <button type="submit" name="_pick" value="move-row-up:{{ loop.index0 }}:" data-action="home-section-form#moveRow">Yukarı taşı</button>
                <button type="submit" name="_pick" value="move-row-down:{{ loop.index0 }}:" data-action="home-section-form#moveRow">Aşağı taşı</button>
            {% endif %}
            <button class="danger-button" type="submit" name="_pick" value="remove-row:{{ loop.index0 }}:" data-action="home-section-form#removeRow">Satırı sil</button>
        </fieldset>
    {% endfor %}

    <button type="submit" name="_pick" value="add-row::" data-action="home-section-form#addRow">Satır ekle</button>

    <template data-home-section-form-target="prototype">
        <fieldset class="cms-row" data-index="0" data-home-section-form-target="row">
            {% if type.value == 'announcement_bar' %}<legend>1. satır</legend>{% endif %}
            {% for field in type.rowFields %}
                {% set name = rows ~ '_0_' ~ field %}
                {% if field in ['image', 'mobileImage'] %}
                    {% if 'hero_slider' == type.value %}<p><strong>{{ type.fieldLabels()[field] }}</strong></p>{% endif %}
                    {% include 'admin/cms/home/_image.html.twig' with {name: name, current: '', library: library, mobile: 'mobileImage' == field} only %}
                    {% if 'mobileImage' == field %}<p class="help-text">680px ve altında kullanılır. Görsel seçilmezse mağazanın placeholder görseli gösterilir.</p>{% endif %}
                {% elseif type.isLinkField(field) %}
                    {% include 'admin/cms/home/_link.html.twig' with {name: name, value: ''} only %}
                {% elseif type.isSourceField(field) %}
                    {# A brand new row starts on the manual source, which is the only one whose
                       products an administrator fills in — so the picker below comes with it. #}
                    <div class="cms-field">
                        <label for="{{ name }}-new">{{ type.fieldLabels()[field] }}</label>
                        <select id="{{ name }}-new" name="{{ name }}">
                            {% for choice in type.sourceChoices %}
                                <option value="{{ choice.value }}"{{ choice.value == 'featured' ? ' selected' : '' }}>{{ choice.label }}</option>
                            {% endfor %}
                        </select>
                        <p class="help-text">Bu kaynak seçiliyken ürünler mağazadaki gerçek verilerden sıralanır. Yalnızca “Öne Çıkanlar” seçilirse aşağıdaki listeden manuel ürün seçebilirsiniz.</p>
                    </div>
                {% else %}
                    <div class="cms-field">
                        <label for="{{ name }}-new">{{ type.fieldLabels()[field]|default(field) }}</label>
                        {% if 'text' == field %}
                            <textarea id="{{ name }}-new" name="{{ name }}" rows="3" maxlength="500"></textarea>
                        {% else %}
                            <input id="{{ name }}-new" type="text" name="{{ name }}" maxlength="500">
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            {% if type.selectionPerRow %}
                {% include 'admin/cms/home/_picker.html.twig' with {
                    kind: type.selection(),
                    prefix: rows ~ '_0_p',
                    target: rows ~ '_0_p',
                    slugs: [],
                    query: query,
                    options: options,
                    labels: labels,
                } only %}
            {% endif %}
            {% if type.value == 'announcement_bar' %}
                <button type="submit" name="_pick" value="move-row-up:0:" data-action="home-section-form#moveRow">Yukarı taşı</button>
                <button type="submit" name="_pick" value="move-row-down:0:" data-action="home-section-form#moveRow">Aşağı taşı</button>
                <button class="danger-button" type="submit" name="_pick" value="remove-row:0:" data-action="home-section-form#removeRow">Satırı sil</button>
            {% endif %}
        </fieldset>
    </template>
</div>
