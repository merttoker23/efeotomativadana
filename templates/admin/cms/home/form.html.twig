{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}

{% block title %}{{ section ? 'Bölümü düzenle' : 'Yeni ana sayfa bölümü' }}{% endblock %}

{% block body %}
<section class="panel">
    <h1>{{ section ? 'Bölümü düzenle' : 'Yeni ana sayfa bölümü' }}</h1>

    {% if not section %}
        {# The type is chosen before the form is opened rather than submitted with it, so the
           fields on screen always match the type whose validation will judge them. #}
        <nav class="admin-type-picker" aria-label="Bölüm türü">
            {% for candidate in types %}
                <a class="button{{ candidate == type ? ' is-current' : '' }}" href="{{ path('admin_cms_home_new', {type: candidate.value}) }}">{{ candidate.label }}</a>
            {% endfor %}
        </nav>
    {% endif %}

    <p class="help-text"><strong>{{ type.label }}</strong> — {{ type.placement }}</p>

    {% if error %}<div class="alert alert-error" role="alert">{{ ui.text(error) }}</div>{% endif %}
    {% if notice %}<div class="alert" role="status">{{ notice }}</div>{% endif %}

    <form method="post" enctype="multipart/form-data" class="cms-section-form">
        <input type="hidden" name="_token" value="{{ csrf_token('cms_home_form') }}">
        <input type="hidden" name="type" value="{{ type.value }}">

        <div class="form-grid">
            <div>
                <label for="title">Bölüm başlığı</label>
                <input id="title" type="text" name="title" value="{{ title }}" maxlength="255" required>
            </div>
            <div>
                <label for="subtitle">Alt başlık (isteğe bağlı)</label>
                <input id="subtitle" type="text" name="subtitle" value="{{ subtitle }}" maxlength="500">
            </div>
        </div>

        {% for field, kind in type.fields() %}
            <div class="cms-field">
                <label for="field-{{ field }}">{{ type.fieldLabels()[field]|default(field) }}</label>
                {% if 'textarea' == kind %}
                    <textarea id="field-{{ field }}" name="{{ field }}" rows="3" maxlength="500">{{ draft[field]|default('') }}</textarea>
                {% elseif 'link' == kind %}
                    {% include 'admin/cms/home/_link.html.twig' with {name: field, value: draft[field]|default('')} only %}
                {% elseif 'number' == kind %}
                    <input id="field-{{ field }}" type="number" name="{{ field }}" value="{{ draft[field]|default(3) }}" min="1" max="12">
                {% else %}
                    <input id="field-{{ field }}" type="text" name="{{ field }}" value="{{ draft[field]|default('') }}" maxlength="500">
                {% endif %}
            </div>
        {% endfor %}

        {% if type.rowName() %}
            {% include 'admin/cms/home/_rows.html.twig' with {
                type: type,
                items: draft[type.rowName()],
                query: query,
                options: options,
                labels: labels,
                library: library,
            } only %}
        {% endif %}

        {% if type.selection() and not type.selectionPerRow() %}
            {% include 'admin/cms/home/_picker.html.twig' with {
                kind: type.selection(),
                prefix: 'slugs',
                target: 'slugs',
                slugs: draft.slugs|default([]),
                query: query,
                options: options,
                labels: labels,
            } only %}
        {% endif %}

        <div class="button-row">
            {# First in the form on purpose: pressing Enter in a field submits the section. #}
            <button type="submit" name="_action" value="save">Bölümü kaydet</button>
            <a class="button-link" href="{{ path('admin_cms_home_index') }}">Vazgeç</a>
        </div>
    </form>

    {% if section %}
        <section class="danger-zone">
            <h2>Bu bölümü sil</h2>
            <form method="post" action="{{ path('admin_cms_home_delete', {id: section.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}">
                <button class="danger-button" type="submit">Bölümü sil</button>
            </form>
        </section>
    {% endif %}
</section>
{% endblock %}
