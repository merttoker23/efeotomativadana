{% extends 'admin/base.html.twig' %}{% block title %}{{ section ? 'Edit section' : 'Add section' }}{% endblock %}{% block body %}<section class="panel"><h1>{{ section ? 'Edit section' : 'Add section' }}</h1><p>Use JSON data for the selected block type. Images must be uploaded first in <a href="{{ path('admin_cms_media_index') }}">CMS media</a>. Links must start with a single slash.</p>{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('cms_home_form') }}"><label for="type">Block type</label><select id="type" name="type" {% if section %}disabled{% endif %}>{% for type in types %}<option value="{{ type.value }}" {{ values.type == type.value ? 'selected' : '' }}>{{ type.value|replace({'_': ' '})|title }}</option>{% endfor %}</select>{% if section %}<input type="hidden" name="type" value="{{ section.type.value }}">{% endif %}<label for="title">Title</label><input id="title" name="title" value="{{ values.title }}" required maxlength="255"><label for="subtitle">Subtitle</label><input id="subtitle" name="subtitle" value="{{ values.subtitle }}" maxlength="500"><label for="configuration">Configuration JSON</label><textarea id="configuration" name="configuration" rows="12" required>{{ values.configuration }}</textarea><p>Examples: features <code>{"features":[{"title":"Fast delivery","description":"From Adana"}]}</code>; products <code>{"slugs":["brake-pad"]}</code>; blog <code>{"limit":3}</code>.</p><button type="submit">Save section</button></form>{% if section %}<form method="post" action="{{ path('admin_cms_home_delete', {id: section.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cms_section_' ~ section.id) }}"><button class="danger-button" type="submit">Delete section</button></form>{% endif %}</section>{% endblock %}
