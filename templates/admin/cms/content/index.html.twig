{% extends 'admin/base.html.twig' %}{% block title %}{{ kind == 'blog' ? 'Blog posts' : 'Information pages' }}{% endblock %}{% block body %}<section class="panel"><h1>{{ kind == 'blog' ? 'Blog posts' : 'Information pages' }}</h1><p><a href="{{ path('admin_cms_content_new', {kind: kind}) }}">Add {{ kind == 'blog' ? 'post' : 'page' }}</a></p><div class="admin-table-wrap"><table><thead><tr><th>Title</th><th>Slug</th><th>Status</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="{{ path('admin_cms_content_edit', {kind: kind, id: item.id}) }}">{{ item.title }}</a></td><td>{{ item.slug }}</td><td>{{ item.published ? 'Published' : 'Draft' }}</td></tr>{% else %}<tr><td colspan="3">No content yet.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
