{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}{{ kind == 'blog' ? 'Blog yazıları' : 'Bilgi sayfaları' }}{% endblock %}{% block body %}<section class="panel"><h1>{{ kind == 'blog' ? 'Blog yazıları' : 'Bilgi sayfaları' }}</h1><p><a class="button-link" href="{{ path('admin_cms_content_new', {kind: kind}) }}">{{ kind == 'blog' ? 'Yeni blog yazısı' : 'Yeni sayfa' }}</a></p><div class="admin-table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu"><table><caption class="visually-hidden">{{ kind == 'blog' ? 'Blog yazıları' : 'Bilgi sayfaları' }}</caption><thead><tr><th scope="col">Başlık</th><th scope="col">URL kısa adı (slug)</th><th scope="col">Durum</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="{{ path('admin_cms_content_edit', {kind: kind, id: item.id}) }}">{{ item.title }}</a></td><td>{{ item.slug }}</td><td>{{ ui.badge(item.published ? 'published' : 'draft') }}</td></tr>{% else %}<tr><td colspan="3">Henüz içerik yok. İlk içeriğinizi ekleyin.</td></tr>{% endfor %}</tbody></table></div>{% if page.totalPages > 1 %}<nav class="pagination" aria-label="İçerik sayfaları">{% if page.hasPrevious %}<a href="{{ path('admin_cms_content_index', {kind: kind, page: page.page - 1}) }}" rel="prev">Önceki</a>{% endif %}{% for number in page.pageNumbers %}<a href="{{ path('admin_cms_content_index', {kind: kind, page: number}) }}"{% if number == page.page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}{% if page.hasNext %}<a href="{{ path('admin_cms_content_index', {kind: kind, page: page.page + 1}) }}" rel="next">Sonraki</a>{% endif %}</nav>{% endif %}</section>{% endblock %}