{% extends 'admin/base.html.twig' %}{% block title %}{{ kind == 'blog' ? 'Blog posts' : 'Information pages' }}{% endblock %}{% block body %}<section class="panel"><h1>{{ kind == 'blog' ? 'Blog posts' : 'Information pages' }}</h1><p><a class="button-link" href="{{ path('admin_cms_content_new', {kind: kind}) }}">Add {{ kind == 'blog' ? 'post' : 'page' }}</a></p><div class="admin-table-wrap"><table><caption class="visually-hidden">{{ kind == 'blog' ? 'Blog posts' : 'Information pages' }}</caption><thead><tr><th scope="col">Title</th><th scope="col">Slug</th><th scope="col">Status</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="{{ path('admin_cms_content_edit', {kind: kind, id: item.id}) }}">{{ item.title }}</a></td><td>{{ item.slug }}</td><td>{{ item.published ? 'Published' : 'Draft' }}</td></tr>{% else %}<tr><td colspan="3">No content yet.</td></tr>{% endfor %}</tbody></table></div>{% if page.totalPages > 1 %}<nav class="pagination" aria-label="Content pages">{% if page.hasPrevious %}<a href="{{ path('admin_cms_content_index', {kind: kind, page: page.page - 1}) }}" rel="prev">Previous</a>{% endif %}{% for number in page.pageNumbers %}<a href="{{ path('admin_cms_content_index', {kind: kind, page: number}) }}"{% if number == page.page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}{% if page.hasNext %}<a href="{{ path('admin_cms_content_index', {kind: kind, page: page.page + 1}) }}" rel="next">Next</a>{% endif %}</nav>{% endif %}</section>{% endblock %}