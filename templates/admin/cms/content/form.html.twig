{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}{{ kind == 'blog' ? (item ? 'Blog yazısını düzenle' : 'Yeni blog yazısı') : (item ? 'Sayfayı düzenle' : 'Yeni sayfa') }}{% endblock %}{% block body %}<section class="panel"><h1>{{ kind == 'blog' ? (item ? 'Blog yazısını düzenle' : 'Yeni blog yazısı') : (item ? 'Sayfayı düzenle' : 'Yeni sayfa') }}</h1>{% if error %}<div class="alert alert-error" role="alert">{{ ui.text(error) }}</div>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('cms_content_form_' ~ kind) }}"><label for="title">Başlık</label><input id="title" name="title" value="{{ values.title }}" maxlength="255" required><label for="slug">URL kısa adı (slug)</label><input id="slug" name="slug" value="{{ values.slug }}" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="255" required><p class="help-text">Yayındaki URL kısa adı değişirse eski adres kalıcı olarak yeni adrese yönlendirilir.</p>{% if kind == 'blog' %}<label for="excerpt">Kısa açıklama</label><textarea id="excerpt" name="excerpt" maxlength="1000" required>{{ values.excerpt }}</textarea>{% endif %}<label for="body">İçerik (düz metin)</label><textarea id="body" name="body" rows="15" required>{{ values.body }}</textarea><label><input type="checkbox" name="published" value="1" {{ values.published ? 'checked' : '' }}> Yayında</label><button type="submit">Kaydet</button></form>{% if item %}<form method="post" action="{{ path('admin_cms_content_delete', {kind: kind, id: item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cms_content_' ~ kind ~ '_' ~ item.id) }}"><button class="danger-button" type="submit">Sil</button></form>{% endif %}</section>{% endblock %}
