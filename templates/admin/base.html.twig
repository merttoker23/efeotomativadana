<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}Administration{% endblock %} | Efe Otomotiv Adana</title>
        <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body class="admin-page">
        <header class="admin-header">
            <a class="brand" href="{{ path('admin_dashboard') }}">Efe Otomotiv Administration</a>
            <nav aria-label="Administrator navigation">
                <a href="{{ path('admin_dashboard') }}">Dashboard</a>
                <a href="{{ path('admin_catalog_product_index') }}">Products</a>
                <a href="{{ path('admin_catalog_category_index') }}">Categories</a>
                <a href="{{ path('admin_catalog_brand_index') }}">Brands</a>
                <a href="{{ path('admin_customer_index') }}">Customers</a>
                <a href="{{ path('admin_order_index') }}">Orders</a>
                <a href="{{ path('admin_payment_index') }}">Payments</a>
                <a href="{{ path('admin_cms_home_index') }}">Homepage</a>
                <a href="{{ path('admin_cms_content_index', {kind: 'blog'}) }}">Blog</a>
                <a href="{{ path('admin_cms_content_index', {kind: 'pages'}) }}">Pages</a>
                <a href="{{ path('admin_integration_b2b') }}">B2B sync</a>
                <a href="{{ path('admin_settings') }}">Store settings</a>
                <form method="post" action="{{ path('admin_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit">Sign out</button>
                </form>
            </nav>
        </header>

        <main class="admin-content">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="status">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-error" role="alert">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
