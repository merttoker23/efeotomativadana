{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}

{% block title %}Kargolar{% endblock %}

{% block body %}
<section class="panel">
<h1>Kargolar</h1>
<p>Kargoların teslimat durumunu ve takip bilgilerini yönetin. Kargo hareketleri sipariş durumundan ayrı takip edilir.</p>

<form method="get" action="{{ path('admin_shipment_index') }}" class="admin-filters">
    <label for="shipment-query">Ara<input type="search" id="shipment-query" name="q" value="{{ query }}" placeholder="Sipariş no, müşteri e-postası veya takip numarası"></label>
    <label for="shipment-state">Durum<select id="shipment-state" name="state">
        <option value="">Tümü</option>
        {% for state in states %}
            <option value="{{ state.value }}"{{ state.value == state_filter ? ' selected' : '' }}>{{ ui.text(state.value) }}</option>
        {% endfor %}
    </select></label>
    <button type="submit">Filtrele</button>
</form>

<div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
    <table class="admin-table">
    <caption class="visually-hidden">Kargolar</caption>
    <thead>
        <tr>
            <th scope="col">Sipariş</th>
            <th scope="col">Müşteri</th>
            <th scope="col">Durum</th>
            <th scope="col">Yöntem</th>
            <th scope="col">Takip numarası</th>
            <th scope="col">Güncellenen</th>
        </tr>
    </thead>
    <tbody>
        {% for shipment in page.items %}
            <tr>
                <td><a href="{{ path('admin_shipment_show', {orderNumber: shipment.order.orderNumber}) }}">{{ shipment.order.orderNumber }}</a></td>
                <td>{{ shipment.order.customerEmail }}</td>
                <td><span class="admin-badge" data-status="{{ shipment.state.value }}">{{ ui.text(shipment.state.value) }}</span></td>
                <td>{{ shipment.methodLabel }}</td>
                <td>{{ shipment.trackingNumber ?? '—' }}</td>
                <td>{{ shipment.updatedAt|date('d.m.Y H:i') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6">Gösterilecek kargo kaydı yok.</td></tr>
        {% endfor %}
    </tbody>
    </table>
</div>

{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_shipment_index', query: {q: query, state: state_filter}} %}
</section>
{% endblock %}
