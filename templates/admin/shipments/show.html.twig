{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}
{% if cancelForm is defined and cancelForm %}{% form_theme cancelForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if createForm is defined and createForm %}{% form_theme createForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if deliverForm is defined and deliverForm %}{% form_theme deliverForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if handOverForm is defined and handOverForm %}{% form_theme handOverForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if inTransitForm is defined and inTransitForm %}{% form_theme inTransitForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if labelForm is defined and labelForm %}{% form_theme labelForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if retryForm is defined and retryForm %}{% form_theme retryForm 'admin/_form_theme.html.twig' %}{% endif %}
{% if statusForm is defined and statusForm %}{% form_theme statusForm 'admin/_form_theme.html.twig' %}{% endif %}

{% block title %}Kargo {{ order.orderNumber }}{% endblock %}

{% block body %}
<section class="panel">
<h1>Kargo</h1>

<p>
    <a href="{{ path('admin_order_show', {orderNumber: order.orderNumber}) }}">{{ order.orderNumber }}</a>
    — {{ order.customerEmail }} ({{ order.customerName }})
</p>

{% if shipment is null %}
    <h2>Henüz kargo oluşturulmadı</h2>
    {% if order.state.value == 'confirmed' %}
        <p>Sipariş onaylandı ve paketleme bekliyor. Kargo oluşturma işlemi tekrarlandığında mevcut kargo kaydı kullanılır.</p>
        {{ form_start(createForm) }}{{ form_widget(createForm) }}{{ form_end(createForm) }}
    {% else %}
        <p>Kargo oluşturmak için siparişin onaylanmış olması gerekir. Sipariş durumu:
           <strong>{{ ui.text(order.state.value) }}</strong>.</p>
    {% endif %}
{% else %}
    <dl class="admin-summary">
        <dt>Durum</dt>
        <dd><span class="admin-badge" data-status="{{ shipment.state.value }}">{{ ui.text(shipment.state.value) }}</span> — {{ tracking.stateLabel }}</dd>
        <dt>Yöntem</dt>
        <dd>{{ tracking.methodLabel }} <small>({{ shipment.methodKey }})</small></dd>
        <dt>Teslimatı yapan</dt>
        <dd>{{ shipment.isHandFulfilledByStore ? 'Mağaza' : shipment.providerKey }}</dd>
        <dt>Takip numarası</dt>
        <dd>{{ tracking.hasTrackingNumber ? tracking.trackingNumber : '—' }}</dd>
        <dt>Kargo firması referansı</dt>
        <dd>{{ shipment.providerReference ?? '—' }}</dd>
        <dt>Sipariş durumu</dt>
        <dd>{{ ui.text(order.state.value) }}</dd>
        <dt>Oluşturulma</dt>
        <dd>{{ shipment.createdAt|date('d.m.Y H:i') }}</dd>
        <dt>Teslimata hazır</dt>
        <dd>{{ shipment.readyAt ? shipment.readyAt|date('d.m.Y H:i') : '—' }}</dd>
        <dt>Yolda</dt>
        <dd>{{ shipment.inTransitAt ? shipment.inTransitAt|date('d.m.Y H:i') : '—' }}</dd>
        <dt>Teslim edildi</dt>
        <dd>{{ shipment.deliveredAt ? shipment.deliveredAt|date('d.m.Y H:i') : '—' }}</dd>
    </dl>

    {% if shipment.failure %}
        <h2>Son hata</h2>
        <p class="alert alert-error" role="alert">
            <strong>{{ shipment.failure.code }}</strong>
            {% if shipment.failure.message %}<br>{{ shipment.failure.message }}{% endif %}
        </p>
    {% endif %}

    <h2>İşlemler</h2>
    {% if handOverForm %}<p>Bu kargonun teslimatını mağaza gerçekleştiriyor.</p>{{ form_start(handOverForm) }}{{ form_widget(handOverForm) }}{{ form_end(handOverForm) }}{% endif %}
    {% if inTransitForm %}{{ form_start(inTransitForm) }}{{ form_widget(inTransitForm) }}{{ form_end(inTransitForm) }}{% endif %}
    {% if deliverForm %}{{ form_start(deliverForm) }}{{ form_widget(deliverForm) }}{{ form_end(deliverForm) }}{% endif %}
    {% if statusForm %}<p>Kargo firmasından güncel teslimat durumunu sorgulayın.</p>{{ form_start(statusForm) }}{{ form_widget(statusForm) }}{{ form_end(statusForm) }}{% endif %}
    {% if labelForm %}<p>Takip numarası kargo etiketi oluşturulduğunda gelebilir. Etiket belgesi bu ekranda saklanmaz.</p>{{ form_start(labelForm) }}{{ form_widget(labelForm) }}{{ form_end(labelForm) }}{% endif %}
    {% if retryForm %}<p>Kargo firması gönderiyi kabul etmedi. Yeniden denemek için işlemi başlatın.</p>{{ form_start(retryForm) }}{{ form_widget(retryForm) }}{{ form_end(retryForm) }}{% endif %}
    {% if cancelForm %}{{ form_start(cancelForm) }}{{ form_widget(cancelForm) }}{{ form_end(cancelForm) }}{% endif %}
    {% if not handOverForm and not inTransitForm and not deliverForm and not statusForm and not labelForm and not retryForm and not cancelForm %}
        <p>Bu kargo için kullanılabilir işlem yok.</p>
    {% endif %}

    <h2>Kargo geçmişi</h2>
    <p>Kargo hareketleri, sorgulamalar ve başarısız denemeler. Sipariş hareketlerini
       <a href="{{ path('admin_order_show', {orderNumber: order.orderNumber}) }}">sipariş sayfasında görebilirsiniz</a>.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
        <table class="admin-table">
        <caption class="visually-hidden">Kargo geçmişi</caption>
        <thead>
            <tr>
                <th scope="col">Durum</th>
                <th scope="col">Kaynak</th>
                <th scope="col">Açıklama</th>
                <th scope="col">Tarih</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ ui.badge(event.toState.value) }}</td>
                    <td>{{ ui.text(event.source) }}</td>
                    <td>{{ ui.text(event.detail ?? '—') }}</td>
                    <td>{{ event.occurredAt|date('d.m.Y H:i') }}</td>
                </tr>
            {% endfor %}
        </tbody>
        </table>
    </div>
{% endif %}
</section>
{% endblock %}
