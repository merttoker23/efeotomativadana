{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}

{% block title %}İadeler{% endblock %}

{% block body %}
<section class="panel">
<h1>İadeler</h1>
<p class="eyebrow">Satış yönetimi</p>
<p>Müşterilerin iade taleplerini ve mağazanın işlem geçmişini takip edin. İade işlemleri sipariş kaydından ayrı yürütülür.</p>

<form method="get" action="{{ path('admin_return_index') }}" class="filter-bar">
    <label for="return-query">Ara<input type="search" id="return-query" name="q" value="{{ query }}" placeholder="İade no, sipariş no veya gerekçe"></label>
    <label for="return-state">Durum<select id="return-state" name="state">
        <option value="">Tümü</option>
        {% for state in states %}
            <option value="{{ state.value }}"{{ state.value == state_filter ? ' selected' : '' }}>{{ ui.text(state.value) }}</option>
        {% endfor %}
    </select></label>
    <button type="submit">Filtrele</button>
</form>

<div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu">
    <table>
        <caption class="visually-hidden">İade talepleri</caption>
        <thead>
        <tr><th scope="col">İade</th><th scope="col">Sipariş</th><th scope="col">Müşteri</th><th scope="col">Durum</th><th scope="col">Ürünler</th><th scope="col">Tutar</th><th scope="col">Talep tarihi</th></tr>
        </thead>
        <tbody>
        {% for item in page.items %}
            <tr data-testid="return-row">
                <td><a href="{{ path('admin_return_show', {returnNumber: item.returnNumber}) }}">{{ item.returnNumber }}</a></td>
                <td><a href="{{ path('admin_order_show', {orderNumber: item.orderNumber}) }}">{{ item.orderNumber }}</a></td>
                <td>{{ item.customerEmail }}</td>
                <td><span class="status-badge" data-status="{{ item.state.value }}">{{ ui.text(item.state.value) }}</span></td>
                <td>{{ item.items|length }}</td>
                <td>{{ item.totalValue|storefront_money }}</td>
                <td>{{ item.createdAt|date('d.m.Y H:i') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="7">Gösterilecek iade talebi yok.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_return_index', query: {q: query, state: state_filter}} only %}
</section>
{% endblock %}
