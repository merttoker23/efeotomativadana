{% extends 'admin/base.html.twig' %}{% block title %}Customers{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Commerce</p><h1>Customers</h1><form class="filter-bar" method="get"><label>Search <input type="search" name="q" value="{{ query }}"></label><label>Status <select name="status"><option value="">All</option><option value="active" {{ status == 'active' ? 'selected' }}>Active</option><option value="inactive" {{ status == 'inactive' ? 'selected' }}>Inactive</option></select></label><button type="submit">Filter</button></form><p data-testid="result-summary">{{ page.total }} customers</p><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>{% for customer in page.items %}<tr data-testid="customer-row"><td>{{ customer.fullName }}</td><td>{{ customer.userIdentifier }}</td><td>{{ customer.active ? 'Active' : 'Inactive' }}</td><td>{{ customer.createdAt|date('Y-m-d') }}</td><td><a href="{{ path('admin_customer_show', {id: customer.id}) }}">View</a></td></tr>{% else %}<tr><td colspan="5">No customers found.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_customer_index', query: {q: query, status: status}} only %}</section>{% endblock %}
