{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}Müşteriler{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Satış yönetimi</p><h1>Müşteriler</h1><form class="filter-bar" method="get"><label>Ara <input type="search" name="q" value="{{ query }}"></label><label>Durum <select name="status"><option value="">Tümü</option><option value="active" {{ status == 'active' ? 'selected' }}>Aktif</option><option value="inactive" {{ status == 'inactive' ? 'selected' }}>Pasif</option></select></label><button type="submit">Filtrele</button></form><p data-testid="result-summary">{{ page.total }} müşteri</p><div class="table-wrap" tabindex="0" role="region" aria-label="Kayıt tablosu"><table><thead><tr><th scope="col">Ad</th><th scope="col">E-posta</th><th scope="col">Durum</th><th scope="col">Oluşturulma</th><th scope="col"><span class="visually-hidden">İşlemler</span></th></tr></thead><tbody>{% for customer in page.items %}<tr data-testid="customer-row"><td>{{ customer.fullName }}</td><td>{{ customer.userIdentifier }}</td><td>{{ ui.badge(customer.active ? 'active' : 'inactive') }}</td><td>{{ customer.createdAt|date('d.m.Y') }}</td><td><a href="{{ path('admin_customer_show', {id: customer.id}) }}">Görüntüle</a></td></tr>{% else %}<tr><td colspan="5">Müşteri bulunamadı. Arama veya filtreleri değiştirin.</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {page: page, route: 'admin_customer_index', query: {q: query, status: status}} only %}</section>{% endblock %}
