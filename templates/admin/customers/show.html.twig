{% extends 'admin/base.html.twig' %}{% block title %}Customer {{ customer.fullName }}{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Customer account</p><h1>{{ customer.fullName }}</h1><dl class="detail-grid"><dt>Email</dt><dd>{{ customer.userIdentifier }}</dd><dt>Phone</dt><dd>{{ customer.phone ?? '—' }}</dd><dt>Status</dt><dd>{{ customer.active ? 'Active' : 'Inactive' }}</dd><dt>Created</dt><dd>{{ customer.createdAt|date('Y-m-d H:i') }}</dd></dl><h2>Addresses</h2>{% for address in addresses %}<article class="subpanel"><h3>{{ address.label }}</h3><p>{{ address.recipientName }} · {{ address.phone }}</p><p>{{ address.addressLine1 }}{% if address.addressLine2 %}, {{ address.addressLine2 }}{% endif %}<br>{{ address.district }} / {{ address.city }}</p></article>{% else %}<p>No addresses.</p>{% endfor %}<form method="post" action="{{ path('admin_customer_status', {id: customer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('customer_status_' ~ customer.id) }}"><input type="hidden" name="status" value="{{ customer.active ? 'deactivate' : 'activate' }}"><button class="{{ customer.active ? 'danger-button' : '' }}" type="submit">{{ customer.active ? 'Deactivate customer' : 'Activate customer' }}</button></form></section>{% endblock %}
