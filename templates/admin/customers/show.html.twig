{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}{% block title %}Müşteri {{ customer.fullName }}{% endblock %}{% block body %}<section class="panel"><p class="eyebrow">Müşteri hesabı</p><h1>{{ customer.fullName }}</h1><dl class="detail-grid"><dt>E-posta</dt><dd>{{ customer.userIdentifier }}</dd><dt>Telefon</dt><dd>{{ customer.phone ?? '—' }}</dd><dt>Durum</dt><dd>{{ ui.badge(customer.active ? 'active' : 'inactive') }}</dd><dt>Oluşturulma</dt><dd>{{ customer.createdAt|date('d.m.Y H:i') }}</dd></dl><p><a href="{{ path('admin_reward_customer', {customerId: customer.id}) }}">Ödül bakiyesi ve puan düzenleme</a></p><h2>Adresler</h2>{% for address in addresses %}<article class="subpanel"><h3>{{ address.label }}</h3><p>{{ address.recipientName }} · {{ address.phone }}</p><p>{{ address.addressLine1 }}{% if address.addressLine2 %}, {{ address.addressLine2 }}{% endif %}<br>{{ address.district }} / {{ address.city }}</p></article>{% else %}<p>Müşterinin kayıtlı adresi yok.</p>{% endfor %}<form method="post" action="{{ path('admin_customer_status', {id: customer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('customer_status_' ~ customer.id) }}"><input type="hidden" name="status" value="{{ customer.active ? 'deactivate' : 'activate' }}"><button class="{{ customer.active ? 'danger-button' : '' }}" type="submit">{{ customer.active ? 'Müşteriyi pasifleştir' : 'Müşteriyi aktifleştir' }}</button></form></section>{% endblock %}
