{% extends 'admin/base.html.twig' %}
{% import 'admin/_labels.html.twig' as ui %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}SEO ayarları — {{ ui.text(subject) }}{% endblock %}

{% block body %}
<section class="panel">
    <p class="eyebrow">Arama motorları</p>
    <h1>SEO ayarları: {{ ui.text(subject) }}</h1>
    <p>
        Tüm alanlar isteğe bağlıdır. Boş bırakılan alanlarda sayfanın mevcut başlığı, açıklaması ve adresi kullanılır.
    </p>

    <div class="form-errors">{{ form(form) }}</div>

    <p><a class="button-link" href="{{ back_url }}">Geri dön: {{ ui.text(subject) }}</a></p>
</section>
{% endblock %}
