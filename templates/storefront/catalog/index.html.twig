{% extends 'storefront/base.html.twig' %}


{% block body %}
<main id="main-content" class="page-shell catalog-page" tabindex="-1">
    <nav class="container breadcrumbs" aria-label="İçerik yolu">
        <a href="{{ path('app_home') }}">Ana Sayfa</a><span aria-hidden="true">/</span><span>{{ heading }}</span>
    </nav>

    <div class="container catalog-layout">
        <aside class="catalog-filters" aria-label="Katalog filtreleri">
            <form method="get" action="{{ app.request.pathInfo }}#catalog-results" class="catalog-filter-form" data-controller="catalog-filters">
                <input type="hidden" name="sort" value="{{ criteria.sort.value }}">
                {% if criteria.query %}<input type="hidden" name="q" value="{{ criteria.query }}">{% endif %}
                {% if criteria.categorySlug and app.request.attributes.get('_route') != 'storefront_catalog_category' %}<input type="hidden" name="category" value="{{ criteria.categorySlug }}">{% endif %}
                {% if criteria.brandSlug and app.request.attributes.get('_route') != 'storefront_catalog_brand' %}<input type="hidden" name="brand" value="{{ criteria.brandSlug }}">{% endif %}
                {% set price_min = criteria.minPriceMinor is not null ? criteria.minPriceMinor / 100 : null %}
                {% set price_max = criteria.maxPriceMinor is not null ? criteria.maxPriceMinor / 100 : null %}
                <fieldset class="catalog-price-range" data-controller="catalog-price-range">
                    <legend>Fiyat Aralığı</legend>
                    <div class="catalog-price-inputs">
                        <label>Min (TL)
                            <input type="number" name="min_price" min="0" step="0.01" inputmode="decimal" value="{{ price_min }}" placeholder="{{ price_bounds.min is not null ? (price_bounds.min / 100)|number_format(2, '.', '') : '0' }}" data-catalog-price-range-target="minInput" data-action="input->catalog-price-range#inputsChanged">
                        </label>
                        <label>Max (TL)
                            <input type="number" name="max_price" min="0" step="0.01" inputmode="decimal" value="{{ price_max }}" placeholder="{{ price_bounds.max is not null ? (price_bounds.max / 100)|number_format(2, '.', '') : '—' }}" data-catalog-price-range-target="maxInput" data-action="input->catalog-price-range#inputsChanged">
                        </label>
                    </div>
                    {% if price_bounds.min is not null and price_bounds.max is not null %}
                        {% set selectable_min = price_bounds.min / 100 %}
                        {% set selectable_max = price_bounds.max / 100 %}
                        <div class="catalog-price-sliders" data-catalog-price-range-target="track">
                            <input type="range" min="{{ selectable_min }}" max="{{ selectable_max }}" step="0.01" value="{{ price_min ?? selectable_min }}" aria-label="Minimum fiyat (TL)" data-catalog-price-range-target="minRange" data-action="input->catalog-price-range#rangeChanged"{% if selectable_min == selectable_max %} disabled{% endif %}>
                            <input type="range" min="{{ selectable_min }}" max="{{ selectable_max }}" step="0.01" value="{{ price_max ?? selectable_max }}" aria-label="Maksimum fiyat (TL)" data-catalog-price-range-target="maxRange" data-action="input->catalog-price-range#rangeChanged"{% if selectable_min == selectable_max %} disabled{% endif %}>
                        </div>
                    {% endif %}
                    <output class="catalog-price-values" data-catalog-price-range-target="output" aria-live="polite">{{ price_min is not null ? price_min|number_format(2, ',', '.') : (price_bounds.min is not null ? (price_bounds.min / 100)|number_format(2, ',', '.') : '0') }} TL — {{ price_max is not null ? price_max|number_format(2, ',', '.') : (price_bounds.max is not null ? (price_bounds.max / 100)|number_format(2, ',', '.') : '∞') }} TL</output>
                    <button type="button" class="catalog-price-reset" data-action="catalog-price-range#reset" hidden data-catalog-price-range-target="reset">Aralığı temizle</button>
                </fieldset>
                <p class="catalog-filter-heading" id="catalog-filter-title">Kategoriler</p>
                <div class="catalog-filter-list catalog-category-list" role="region" aria-labelledby="catalog-filter-title" tabindex="0">
                    {% for category in categories %}
                        {% set category_selected = criteria.categorySlug == category.slug %}
                        {% set category_route = criteria.onSaleOnly ? 'storefront_collections_index' : (category_selected ? 'storefront_catalog_index' : 'storefront_catalog_category') %}
                        {% set category_params = category_selected ? {} : (criteria.onSaleOnly ? {category: category.slug} : {slug: category.slug}) %}
                        <a href="{{ path(category_route, criteria.queryParameters(null, 'category')|merge(category_params)|merge({_fragment: 'catalog-results'})) }}" data-action="click->catalog-filters#navigate"{% if category_selected %} aria-current="page" aria-label="{{ category.name }} filtresini kaldır"{% endif %}>
                            <span>{{ category.name }}</span><small>{{ category.productCount }}</small>
                        </a>
                    {% endfor %}
                </div>
                <p class="catalog-filter-heading" id="catalog-brand-title">Markalar</p>
                <div class="catalog-filter-list catalog-brand-list" role="region" aria-labelledby="catalog-brand-title" tabindex="0">
                    {% for brand in brands %}
                        {% set brand_selected = criteria.brandSlug == brand.slug %}
                        {% set brand_route = criteria.onSaleOnly ? 'storefront_collections_index' : (brand_selected ? 'storefront_catalog_index' : 'storefront_catalog_brand') %}
                        {% set brand_params = brand_selected ? {} : (criteria.onSaleOnly ? {brand: brand.slug} : {slug: brand.slug}) %}
                        <a href="{{ path(brand_route, criteria.queryParameters(null, 'brand')|merge(brand_params)|merge({_fragment: 'catalog-results'})) }}" data-action="click->catalog-filters#navigate"{% if brand_selected %} aria-current="page" aria-label="{{ brand.name }} filtresini kaldır"{% endif %}>
                            <span>{{ brand.name }}</span><small>{{ brand.productCount }}</small>
                        </a>
                    {% endfor %}
                </div>
                <label class="checkbox-field"><input type="checkbox" name="availability" value="in-stock"{% if criteria.inStockOnly %} checked{% endif %}> Yalnızca stoktakiler</label>
                <button type="submit">Filtreleri uygula</button>
            </form>
        </aside>

        <section id="catalog-results" class="catalog-results" aria-labelledby="catalog-heading" tabindex="-1">
            {# The address of the next page of this very query — same route, same filters, same sort,
               one page further on. Empty on the last page, and the controller then stops. #}
            {% set next_page_url = next_page ? path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(criteria.queryParameters(next_page, route_filter))) : '' %}

            <div class="catalog-heading-row">
                <div>
                    {% if criteria.onSaleOnly %}<p class="panel-kicker">Aktif indirim</p>{% endif %}
                    <h1 id="catalog-heading">{{ heading }}</h1>
                    {% if criteria.query %}<p class="search-context">“{{ criteria.query }}” için sonuçlar</p>{% endif %}
                </div>
                <form method="get" action="{{ app.request.pathInfo }}#catalog-results" class="sort-form" data-controller="catalog-sort">
                    {% for key, value in criteria.filterParameters(route_filter) %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
                    <label for="catalog-sort">Sırala</label>
                    <select id="catalog-sort" name="sort" data-action="catalog-sort#submit">
                        <option value="newest"{% if criteria.sort.value == 'newest' %} selected{% endif %}>En yeni</option>
                        <option value="name-asc"{% if criteria.sort.value == 'name-asc' %} selected{% endif %}>Ada göre</option>
                        <option value="price-asc"{% if criteria.sort.value == 'price-asc' %} selected{% endif %}>Fiyat: düşükten yükseğe</option>
                        <option value="price-desc"{% if criteria.sort.value == 'price-desc' %} selected{% endif %}>Fiyat: yüksekten düşüğe</option>
                    </select>
                </form>
            </div>

            <p class="catalog-summary">{{ page.totalItems }} üründen <span class="catalog-summary-range" data-catalog-infinite-scroll-target="range">{{ page.firstItem }} - {{ page.lastItem }}</span> arası gösteriliyor</p>

            {# Every listing here — the whole catalogue, a category, a brand — reads as one long
               grid: it asks for the next page of the very same query as the customer reaches the
               bottom of the grid, and appends it below the cards already on screen. `next_page` is
               null on the last page, and the controller then does nothing at all. #}
            <div class="catalog-listing" data-controller="catalog-infinite-scroll" data-catalog-infinite-scroll-next-url-value="{{ next_page_url }}">
                {% if page.items is empty %}
                    {# An empty collections page is not an error and not the same thing as an empty
                       search, so it says which of the two it is rather than sending the shopper back
                       to the catalogue to be told a product list came back empty. #}
                    {% if criteria.onSaleOnly %}
                        <div class="catalog-empty" role="status"><h2>Şu anda indirimli ürün yok</h2><p>Yeni bir indirim başladığında ürünler burada listelenir.</p></div>
                    {% else %}
                        <div class="catalog-empty" role="status"><h2>Ürün bulunamadı</h2><p>Arama veya filtre seçiminizi değiştirerek tekrar deneyin.</p></div>
                    {% endif %}
                {% else %}
                    <div class="product-grid" data-catalog-infinite-scroll-target="grid">
                        {% for product in page.items %}{% include 'components/product_card.html.twig' with {product: product} only %}{% endfor %}
                    </div>
                {% endif %}

                {% if next_page_url %}
                    <div class="catalog-load-more" data-catalog-infinite-scroll-target="sentinel" aria-hidden="true"></div>
                    <p class="sr-only" role="status" aria-live="polite" data-catalog-infinite-scroll-target="status"></p>
                {% endif %}
            </div>

            {% if page.totalPages > 1 %}
                {% if next_page_url %}
                    {# With scripts running the listing has already replaced this with scrolling. A
                       browser that cannot run them keeps the pagination it always had. #}
                    <noscript>{% include 'storefront/catalog/_pagination.html.twig' with {page: page, criteria: criteria, route_filter: route_filter} only %}</noscript>
                {% else %}
                    {% include 'storefront/catalog/_pagination.html.twig' with {page: page, criteria: criteria, route_filter: route_filter} only %}
                {% endif %}
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}
