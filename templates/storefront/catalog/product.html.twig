{% extends 'storefront/base.html.twig' %}


{% block body %}
<main id="main-content" class="page-shell product-page" tabindex="-1">
    <nav class="container breadcrumbs" aria-label="İçerik yolu">
        <a href="{{ path('app_home') }}">Ana Sayfa</a><span aria-hidden="true">/</span>
        <a href="{{ path('storefront_catalog_index') }}">Ürünler</a><span aria-hidden="true">/</span><span>{{ product.name }}</span>
    </nav>

    <article class="container product-detail">
        <section class="product-gallery" aria-label="Ürün görselleri" data-controller="product-gallery">
            <div class="product-gallery-main">
            {% if product.images is empty %}
                <img src="{{ product_image_url(null) }}" alt="{{ product.name }} için temsili görsel" width="400" height="320" fetchpriority="high" decoding="async" data-product-gallery-target="main">
            {% else %}
                {% set image = product.images|first %}
                {% set dimensions = image_dimensions(image.path) %}
                <img src="{{ media_url(image.path) }}" alt="{{ image.alt }}"{% if dimensions %} width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %} fetchpriority="high" decoding="async" data-product-gallery-target="main">
            {% endif %}
            </div>
            {% if product.images|length > 1 %}
                <div class="product-gallery-thumbnails" aria-label="Görsel seçimi">
                {% for image in product.images %}
                    {% set dimensions = image_dimensions(image.path) %}
                    <button class="product-gallery-thumbnail" type="button" aria-label="{{ loop.index }}. görseli göster" aria-pressed="{{ loop.first ? 'true' : 'false' }}" data-product-gallery-target="thumbnail" data-action="product-gallery#select">
                        <img src="{{ media_url(image.path) }}" alt="{{ image.alt }}"{% if dimensions %} width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %} decoding="async" loading="lazy">
                    </button>
                {% endfor %}
                </div>
            {% endif %}
        </section>

        <section class="product-meta">
            <p class="product-code-line">
                {% if product.brandName %}<a href="{{ path('storefront_catalog_brand', {slug: product.brandSlug, _fragment: 'catalog-results'}) }}">{{ product.brandName }}</a><span aria-hidden="true"> · </span>{% endif %}
                <span>SKU: {{ product.sku }}</span>
            </p>
            <h1>{{ product.name }}</h1>
            {% if product.description %}<p class="product-description">{{ product.description }}</p>{% endif %}

            <div class="product-price-large">
                {% if product.sellPrice %}
                    <strong>{{ product.sellPrice|storefront_money }}</strong>
                    {% if product.onSale %}<del>{{ product.basePrice|storefront_money }}</del>{% endif %}
                {% else %}
                    <strong>Fiyat için iletişime geçin</strong>
                {% endif %}
            </div>
            <p class="stock-state {{ product.sellable ? 'is-available' : 'is-unavailable' }}">
                {{ product.sellable ? 'Stokta Var' : 'Stokta Yok' }}
            </p>

            <div class="product-detail-actions">
            {% if product.sellable and product.sellPrice %}
                <form class="cart-add-form" method="post" action="{{ path('storefront_cart_add', {id: product.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                    <label class="visually-hidden" for="product-quantity">Miktar</label>
                    <input id="product-quantity" name="quantity" type="number" min="1" max="{{ product.quantity > 99 ? 99 : product.quantity }}" value="1" inputmode="numeric">
                    <button type="submit">Sepete Ekle</button>
                </form>
            {% endif %}
            <form class="wishlist-add-form" method="post" action="{{ path('storefront_wishlist_add', {id: product.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('wishlist_add_' ~ product.id) }}">
                <button type="submit" aria-label="İstek listesine ekle" title="İstek listesine ekle"><span aria-hidden="true">♡</span><span class="product-action-label">İstek Listesi</span></button>
            </form>
            <form class="compare-add-form" method="post" action="{{ path('storefront_compare_add', {id: product.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('compare_add_' ~ product.id) }}">
                <button type="submit" aria-label="Karşılaştırmaya ekle" title="Karşılaştırmaya ekle"><span aria-hidden="true">↬</span><span class="product-action-label">Karşılaştır</span></button>
            </form>
            </div>

            {% if product.categories %}
                <div class="product-categories"><strong>Kategoriler</strong>{% for category in product.categories %}<a href="{{ path('storefront_catalog_category', {slug: category.slug, _fragment: 'catalog-results'}) }}">{{ category.name }}</a>{% endfor %}</div>
            {% endif %}

        </section>
    </article>

    {% set tabs = [] %}
    {% if product.description %}{% set tabs = tabs|merge([{key: 'description', title: 'Açıklama'}]) %}{% endif %}
    {% if product.attributes %}{% set tabs = tabs|merge([{key: 'attributes', title: 'Teknik Özellikler'}]) %}{% endif %}
    {% if product.identifiers %}{% set tabs = tabs|merge([{key: 'identifiers', title: 'Parça Kodları'}]) %}{% endif %}
    {% if tabs %}
        <section class="container product-information" aria-label="Ürün bilgileri" data-controller="product-tabs">
            <div class="product-information-tabs" role="tablist" aria-label="Ürün bilgileri">
                {% for tab in tabs %}
                    <button type="button" role="tab" id="product-tab-{{ tab.key }}" aria-controls="product-panel-{{ tab.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}" class="{{ loop.first ? 'active' : '' }}" data-product-tabs-target="tab" data-action="product-tabs#select">{{ tab.title }}</button>
                {% endfor %}
            </div>
            {% for tab in tabs %}
                <div class="product-information-panel product-{{ tab.key }}" role="tabpanel" id="product-panel-{{ tab.key }}" aria-labelledby="product-tab-{{ tab.key }}" tabindex="0" data-product-tabs-target="panel"{% if not loop.first %} hidden{% endif %}>
                    {% if tab.key == 'description' %}
                        <p>{{ product.description }}</p>
                    {% elseif tab.key == 'attributes' %}
                        <dl>{% for attribute in product.attributes %}<div><dt>{{ attribute.label }}</dt><dd>{{ attribute.value }}</dd></div>{% endfor %}</dl>
                    {% else %}
                        <dl>{% for identifier in product.identifiers %}<div><dt>{{ identifier.label }}</dt><dd>{{ identifier.code }}</dd></div>{% endfor %}</dl>
                    {% endif %}
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {% if similarProducts %}
        <section class="container similar-products" aria-labelledby="similar-products-title">
            <div class="section-head"><h2 id="similar-products-title">Benzer Ürünler</h2></div>
            <div class="product-grid">
                {% for similarProduct in similarProducts %}
                    {% include 'components/product_card.html.twig' with {product: similarProduct} only %}
                {% endfor %}
            </div>
        </section>
    {% endif %}
</main>
{% endblock %}
