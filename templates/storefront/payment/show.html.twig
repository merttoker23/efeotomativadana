{% extends 'storefront/base.html.twig' %}

{% block title %}Ödeme durumu | {{ store.name }}{% endblock %}

{% block body %}
<main id="main-content" class="page-shell payment-status-page" tabindex="-1">
    <section class="container payment-status-card" aria-labelledby="payment-heading">
        <header class="payment-status-header">
            <p class="checkout-kicker">Siparişiniz</p>
            <h1 id="payment-heading">Ödeme durumu</h1>
            <p class="payment-order-number">Sipariş numarası: <strong>{{ order.orderNumber }}</strong></p>
            <span class="payment-status-badge{{ summary.canPay ? ' is-awaiting' : '' }}" role="status">{{ summary.paymentStatusLabel ?? (summary.canPay ? 'Ödeme bekleniyor' : summary.stateLabel) }}</span>
        </header>

        <dl class="payment-status-totals">
            <div><dt>Ödeme yöntemi</dt><dd>{{ order.paymentOptionLabel }}</dd></div>
            <div class="payment-total"><dt>Toplam</dt><dd>{{ order.grandTotal|storefront_money }}</dd></div>
            {% if summary.capturedAmount and summary.capturedAmount.minorAmount > 0 %}
                <div><dt>Tahsil edilen</dt><dd>{{ summary.capturedAmount|storefront_money }}</dd></div>
            {% endif %}
            {% if summary.hasRefundedAmount %}
                <div><dt>İade edilen</dt><dd>{{ summary.refundedAmount|storefront_money }}</dd></div>
            {% endif %}
        </dl>

        {% if summary.canPay %}
            <p class="payment-status-hint">Ödemenizi güvenli ödeme sayfasında tamamlayabilirsiniz. İşlem sonuçlandığında ödeme durumunuz güncellenir.</p>
            <div class="payment-status-actions">
                {% if payment is null %}
                    <form method="post" action="{{ path('storefront_payment_retry', {orderNumber: order.orderNumber}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('payment_retry') }}">
                        <button type="submit" class="payment-action-primary">Ödemeyi tamamla</button>
                    </form>
                {% else %}
                    {# Fresh signed fields are still generated by the existing protected form route. #}
                    <form method="post" action="{{ path('storefront_payment_form', {orderNumber: order.orderNumber}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('payment_form') }}">
                        <button type="submit" class="payment-action-primary">Ödemeyi tamamla</button>
                    </form>
                    <div class="payment-status-secondary-actions">
                        <form method="post" action="{{ path('storefront_payment_retry', {orderNumber: order.orderNumber}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('payment_retry') }}">
                            <button type="submit" class="payment-action-secondary">Tekrar dene</button>
                        </form>
                        {% if payment.latestAttempt %}
                            <form method="post" action="{{ path('storefront_payment_cancel', {token: payment.latestAttempt.returnToken}) }}">
                                <input type="hidden" name="payment_cancel[_token]" value="{{ csrf_token('payment_cancel') }}">
                                <button type="submit" class="payment-action-secondary payment-action-danger">Ödemeyi iptal et</button>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <a class="payment-continue-link" href="{{ path('storefront_catalog_index') }}">Alışverişe devam et <span aria-hidden="true">→</span></a>
    </section>
</main>
{% endblock %}
