{# The theme's header, its three rows in the theme's own order and nothing else: a top bar, a main
   row of brand / search / actions, and a menu band. `tema/index.html` draws exactly these three and
   `tema/assets/css/style.css` measures every one of them, so the row structure, the lengths, the
   colours and the breakpoints here are the reference's rather than a second arrangement.

   The content is this store's, placed in the slots the reference leaves for it: the store's own two
   lines in the top bar, its name where the reference prints a logo image, the catalogue search
   where the reference prints its search, account / contact / blog as the three white pills of the
   main row, and the wishlist, compare and yellow cart block in the menu band.

   The notice band above this element is not part of the header: the theme puts it at the top of the
   page, above the header, and `storefront/layout/_notice.html.twig` renders it there. The shell
   controller lives on the body so it can reach both. #}
<header class="site-header">
    {# The route this page is, so the account menu can mark the entry the visitor is already on. #}
    {% set route = app.request.attributes.get('_route') %}
    <div class="header-topbar">
        <div class="container topbar">
            <div class="topbar-left">
                <p>Otomotiv yedek parçada yerel uzmanlık</p>
            </div>
            <div class="topbar-right">
                <p>Güvenli alışveriş · Kolay iade · Hızlı destek</p>
            </div>
        </div>
    </div>

    <div class="header-primary">
        <div class="container header-main">
            <a class="storefront-brand" href="{{ path('app_home') }}" aria-label="{{ store.name }} ana sayfa" data-storefront-shell-target="brand">
                <span class="brand-mark" aria-hidden="true">EO</span>
                <span class="brand-copy">
                    <strong>{{ store.name }}</strong>
                    <small>Otomotiv &amp; Yedek Parça</small>
                </span>
            </a>

            <form class="storefront-search" role="search" aria-label="Ürün arama" method="get" action="{{ path('storefront_catalog_index') }}">
                <label class="sr-only" for="storefront-search">Ürün, marka veya parça kodu ara</label>
                <input id="storefront-search" name="q" type="search" value="{{ app.request.query.get('q') }}" placeholder="Ürün, SKU, OEM veya parça kodu ara..." maxlength="120">
                <button type="submit" aria-label="Ürün ara">⌕</button>
            </form>

            {# The theme's three white pills, in its order.

               The account pill is the reference's own — the user mark, the word and the caret that
               says a list is under here — except that the reference never opens one. It is now a
               button that owns a real menu, and what the menu holds is decided by who is asking:
               a visitor is offered the two ways in this store actually has, and a customer is
               offered the account pages that already exist, with the same CSRF-protected POST the
               account navigation has always used. No GET logout is invented for a dropdown, and
               the header keeps no state of its own — `is_granted` is the whole answer.

               `{% set %}` rather than a repeated call, so the two branches cannot disagree about
               whether this is a customer. #}
            {% set signed_in = is_granted('ROLE_CUSTOMER') %}
            {% set header_cart = storefront_cart() %}
            <div class="header-actions" aria-label="Mağaza kısayolları">
                <div class="account-menu" data-controller="header-account">
                    <button
                        class="header-action action-btn account"
                        type="button"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="header-account-menu"
                        aria-label="{{ signed_in ? 'Hesabım menüsü' : 'Hesabım (Giriş ve kayıt)' }}"
                        data-header-account-target="trigger"
                        data-action="header-account#toggle"
                    ><span class="action-icon" aria-hidden="true">♙</span>Hesabım<svg class="action-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 4.25 6 7.75 9.5 4.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>

                    <div class="account-menu-panel" id="header-account-menu" data-header-account-target="menu" hidden>
                        {% if signed_in %}
                            <p class="account-menu-heading">Hesabım</p>
                            <a href="{{ path('customer_account_dashboard') }}"{% if route == 'customer_account_dashboard' %} aria-current="page"{% endif %}>Hesabım</a>
                            <a href="{{ path('customer_account_profile') }}"{% if route == 'customer_account_profile' %} aria-current="page"{% endif %}>Profil</a>
                            <a href="{{ path('customer_account_addresses') }}"{% if route starts with 'customer_account_address' %} aria-current="page"{% endif %}>Adresler</a>
                            <a href="{{ path('customer_account_orders') }}"{% if route starts with 'customer_account_order' %} aria-current="page"{% endif %}>Siparişlerim</a>
                            <a href="{{ path('customer_account_returns') }}"{% if route starts with 'customer_account_return' %} aria-current="page"{% endif %}>İadelerim</a>
                            <a href="{{ path('storefront_wishlist_index') }}"{% if route starts with 'storefront_wishlist_' %} aria-current="page"{% endif %}>İstek Listem</a>
                            <a href="{{ path('customer_account_rewards') }}"{% if route == 'customer_account_rewards' %} aria-current="page"{% endif %}>Puanlarım</a>
                            {# The very same logout the account pages use: a POST carrying the logout
                               CSRF token, against the firewall's own route. Nothing here is a link
                               that a prefetcher, a crawler or a stray `<img>` could follow. #}
                            <form class="account-menu-form" method="post" action="{{ path('customer_logout') }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit">Çıkış Yap</button>
                            </form>
                        {% else %}
                            <p class="account-menu-heading">Hoş geldiniz</p>
                            <a href="{{ path('customer_login') }}">Giriş Yap</a>
                            <a href="{{ path('customer_registration') }}">Kayıt Ol</a>
                        {% endif %}
                    </div>
                </div>
                <a class="header-action action-btn contact" href="{{ path('storefront_contact') }}"><span class="action-icon" aria-hidden="true">✉</span>İletişim</a>
                <a class="header-action action-btn blog" href="{{ path('storefront_blog_index') }}"><span class="action-icon" aria-hidden="true">▤</span>Blog</a>
                <button
                    class="mobile-menu-toggle"
                    type="button"
                    aria-controls="mobile-navigation"
                    aria-expanded="false"
                    aria-label="Menüyü aç"
                    data-storefront-shell-target="toggle"
                    data-action="storefront-shell#toggleMenu"
                ><span aria-hidden="true">☰</span></button>
            </div>
        </div>
    </div>

    {% include 'storefront/layout/_navigation.html.twig' with {header_cart: header_cart} %}
</header>
