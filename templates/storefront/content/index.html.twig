{% extends 'storefront/base.html.twig' %}

{% block body %}
{% set pager = page %}
<main id="main-content" class="page-shell information-page" tabindex="-1">
    <div class="container">
        <nav class="breadcrumbs" aria-label="Sayfa yolu">
            <a href="{{ path('app_home') }}">Ana sayfa</a><span aria-hidden="true">/</span><span>Bilgi Sayfaları</span>
        </nav>
        <section class="generic-card" aria-labelledby="information-heading">
            <h1 id="information-heading" class="page-title">Bilgi Sayfaları</h1>
            <ul class="information-links">
                {% for page in pages %}
                    <li><a class="information-link" href="{{ path('storefront_information_show', {slug: page.slug}) }}">{{ page.title }}</a></li>
                {% else %}
                    <li>Henüz yayınlanmış sayfa yok.</li>
                {% endfor %}
            </ul>
            {% if pager.totalPages > 1 %}
                <nav class="pagination" aria-label="Sayfalama">
                    {% if pager.hasPrevious %}<a href="{{ path('storefront_information_index', {page: pager.page - 1}) }}" rel="prev" aria-label="Önceki sayfa">‹</a>{% endif %}
                    {% for number in pager.pageNumbers %}<a href="{{ path('storefront_information_index', {page: number}) }}"{% if number == pager.page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}
                    {% if pager.hasNext %}<a href="{{ path('storefront_information_index', {page: pager.page + 1}) }}" rel="next" aria-label="Sonraki sayfa">›</a>{% endif %}
                </nav>
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}
