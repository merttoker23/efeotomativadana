{% extends 'storefront/base.html.twig' %}{% block body %}{% set pager = page %}<main id="main-content" class="container content-page" tabindex="-1"><h1>Bilgilendirme</h1><ul>{% for page in pages %}<li><a href="{{ path('storefront_information_show', {slug: page.slug}) }}">{{ page.title }}</a></li>{% else %}<li>Hen&#252;z yay&#305;nlanm&#305;&#351; sayfa yok.</li>{% endfor %}</ul>{% if pager.totalPages > 1 %}<nav class="pagination" aria-label="Bilgilendirme sayfaları">{% if pager.hasPrevious %}<a href="{{ path('storefront_information_index', {page: pager.page - 1}) }}" rel="prev" aria-label="Onceki sayfa">&#8249;</a>{% endif %}{% for number in pager.pageNumbers %}<a href="{{ path('storefront_information_index', {page: number}) }}"{% if number == pager.page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}{% if pager.hasNext %}<a href="{{ path('storefront_information_index', {page: pager.page + 1}) }}" rel="next" aria-label="Sonraki sayfa">&#8250;</a>{% endif %}</nav>{% endif %}</main>{% endblock %}