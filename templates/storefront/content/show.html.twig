{% extends 'storefront/base.html.twig' %}

{% block body %}
<main id="main-content" class="page-shell information-page" tabindex="-1">
    <div class="container">
        <nav class="breadcrumbs" aria-label="Sayfa yolu">
            <a href="{{ path('app_home') }}">Ana sayfa</a><span aria-hidden="true">/</span>
            <a href="{{ path('storefront_information_index') }}">Bilgi Sayfaları</a><span aria-hidden="true">/</span><span>{{ page.title }}</span>
        </nav>
        <article class="generic-card" aria-labelledby="information-heading">
            <h1 id="information-heading" class="page-title">{{ page.title }}</h1>
            <div class="content-body">{{ page.body|nl2br }}</div>
        </article>
    </div>
</main>
{% endblock %}
