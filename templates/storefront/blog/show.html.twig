{% extends 'storefront/base.html.twig' %}


{# Layout and cover sizing follow tema/blog-welcome.html; posts without covers keep its gradient. #}
{% block body %}
    <main id="main-content" class="page-shell" tabindex="-1">
        <nav class="container breadcrumbs" aria-label="Sayfa yolu">
            <a href="{{ path('app_home') }}">Ana Sayfa</a>
            <span aria-hidden="true">/</span>
            <a href="{{ path('storefront_blog_index') }}">Blog</a>
        </nav>

        <article class="container generic-card blog-article">
            <h1 class="page-title">{{ post.title }}</h1>

            <div class="blog-post-hero"{% if not post.coverImagePath %} aria-hidden="true"{% endif %}>{% if post.coverImagePath %}{% set dimensions = image_dimensions(post.coverImagePath) %}<img src="{{ media_url(post.coverImagePath) }}" alt="{{ post.title }}"{% if dimensions %} width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %} decoding="async" fetchpriority="high">{% endif %}</div>

            {% if post.excerpt %}<p class="blog-lead">{{ post.excerpt }}</p>{% endif %}
            {% if post.body %}<div class="blog-prose">{{ post.body|nl2br }}</div>{% endif %}
        </article>
    </main>
{% endblock %}
