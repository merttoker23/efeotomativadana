{% extends 'storefront/base.html.twig' %}{% block body %}{% set pager = page %}<main id="main-content" class="container content-page" tabindex="-1"><h1>Blog</h1><div class="cms-blog-grid">{% for post in posts %}<article><h2><a href="{{ path('storefront_blog_show', {slug: post.slug}) }}">{{ post.title }}</a></h2><p>{{ post.excerpt }}</p></article>{% else %}<p>Hen&#252;z yay&#305;nlanm&#305;&#351; yaz&#305; yok.</p>{% endfor %}</div>{% if pager.totalPages > 1 %}<nav class="pagination" aria-label="Blog sayfaları">{% if pager.hasPrevious %}<a href="{{ path('storefront_blog_index', {page: pager.page - 1}) }}" rel="prev" aria-label="Onceki sayfa">&#8249;</a>{% endif %}{% for number in pager.pageNumbers %}<a href="{{ path('storefront_blog_index', {page: number}) }}"{% if number == pager.page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}{% if pager.hasNext %}<a href="{{ path('storefront_blog_index', {page: pager.page + 1}) }}" rel="next" aria-label="Sonraki sayfa">&#8250;</a>{% endif %}</nav>{% endif %}</main>{% endblock %}