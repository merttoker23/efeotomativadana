{% extends 'storefront/base.html.twig' %}{% block title %}Blog | {{ store.name }}{% endblock %}{% block body %}<main id="main-content" class="container content-page"><h1>Blog</h1><div class="cms-blog-grid">{% for post in posts %}<article><h2><a href="{{ path('storefront_blog_show', {slug: post.slug}) }}">{{ post.title }}</a></h2><p>{{ post.excerpt }}</p></article>{% else %}<p>Henüz yayınlanmış yazı yok.</p>{% endfor %}</div></main>{% endblock %}
