{% extends 'storefront/base.html.twig' %}


{# Layout and cover sizing follow tema/blog.html; posts without covers keep its gradient. #}
{% block body %}
    {% set pager = page %}
    <main id="main-content" class="page-shell" tabindex="-1">
        <nav class="container breadcrumbs" aria-label="Sayfa yolu">
            <a href="{{ path('app_home') }}">Ana Sayfa</a>
            <span aria-hidden="true">/</span>
            <span>Blog</span>
        </nav>

        <div class="container generic-card blog-listing">
            <h1 class="page-title">Blog</h1>

            <div class="blog-list">
                {% for post in posts %}
                    <a class="blog-post-card" href="{{ path('storefront_blog_show', {slug: post.slug}) }}">
                        <span class="blog-post-cover" aria-hidden="true">{% if post.coverImagePath %}<img src="{{ media_url(post.coverImagePath) }}" alt="" loading="lazy" decoding="async">{% endif %}</span>
                        <span class="blog-post-body">
                            <h2>{{ post.title }}</h2>
                            {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
                        </span>
                    </a>
                {% else %}
                    <p class="blog-empty">Henüz yayımlanmış yazı yok.</p>
                {% endfor %}
            </div>

            {% if pager.totalPages > 1 %}
                <nav class="pagination" aria-label="Blog sayfaları">
                    {% if pager.hasPrevious %}<a href="{{ path('storefront_blog_index', {page: pager.page - 1}) }}" rel="prev" aria-label="Önceki sayfa">‹</a>{% endif %}
                    {% for number in pager.pageNumbers %}
                        <a href="{{ path('storefront_blog_index', {page: number}) }}"{% if number == pager.page %} aria-current="page"{% endif %}>{{ number }}</a>
                    {% endfor %}
                    {% if pager.hasNext %}<a href="{{ path('storefront_blog_index', {page: pager.page + 1}) }}" rel="next" aria-label="Sonraki sayfa">›</a>{% endif %}
                </nav>
            {% endif %}
        </div>
    </main>
{% endblock %}
