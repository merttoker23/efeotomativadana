{% extends 'storefront/base.html.twig' %}

{% block title %}Siparişlerim | {{ store.name }}{% endblock %}

{% block body %}
<main id="main-content" class="page-shell" tabindex="-1">
    <div class="container">
        {% include 'storefront/account/_nav.html.twig' %}
        <nav class="breadcrumbs" aria-label="Sayfa yolu">
            <a href="{{ path('app_home') }}">Ana sayfa</a><span aria-hidden="true">/</span><span>Siparişlerim</span>
        </nav>

        <section class="account-card" aria-labelledby="orders-heading">
            <div class="account-heading">
                <h1 id="orders-heading">Siparişlerim</h1>
            </div>

            {% if page.items is empty %}
                <div class="cart-empty" role="status">
                    <p>Henüz siparişiniz yok.</p>
                    <a class="account-primary-link" href="{{ path('storefront_catalog_index') }}">Ürünleri inceleyin</a>
                </div>
            {% else %}
                <div class="order-list">
                    {% for summary in summaries %}
                        {% set order = summary.order %}
                        <details class="order-card order-disclosure" data-testid="order-row">
                            <summary class="order-card-summary">
                                <span class="order-card-identity">
                                    <strong class="order-card-number">{{ order.orderNumber }}</strong>
                                    <span class="order-card-date"><time datetime="{{ order.createdAt|date('c') }}">{{ order.createdAt|date('d.m.Y H:i') }}</time></span>
                                </span>
                                <span class="order-card-preview">
                                    <span class="order-thumbnails" aria-hidden="true">
                                        {% for line in summary.lines|slice(0, 3) %}
                                            <img src="{{ product_image_url(line.imagePath) }}" alt="" width="40" height="40" loading="lazy" decoding="async">
                                        {% endfor %}
                                        {% if summary.lines|length > 3 %}<span class="order-thumbnail-more">+{{ summary.lines|length - 3 }}</span>{% endif %}
                                    </span>
                                    <span class="order-card-count">{{ summary.lines|length }} ürün · {{ summary.quantity }} adet</span>
                                </span>
                                <span class="order-card-state">{{ summary.stateLabel }}{% if not summary.hasPayment %} · Ödeme bekleniyor{% endif %}</span>
                                <span class="order-card-amount" data-testid="order-total"><small>Toplam</small><strong>{{ order.grandTotal|storefront_money }}</strong></span>
                                <span class="order-card-toggle" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18" focusable="false"><path d="m5 7 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                            </summary>
                            <div class="order-card-content">
                                {% include 'storefront/account/_order_products.html.twig' with {lines: summary.lines} only %}
                                <div class="order-card-action"><a class="account-primary-link" href="{{ path('customer_account_order_show', {orderNumber: order.orderNumber}) }}">Siparişi görüntüle</a></div>
                            </div>
                        </details>
                    {% endfor %}
                </div>

                {% if page.pages > 1 %}
                    <nav class="pagination" aria-label="Sipariş sayfaları">
                        {% if page.hasPrevious %}<a rel="prev" href="{{ path('customer_account_orders', {page: page.page - 1}) }}" aria-label="Önceki sayfa">‹</a>{% endif %}
                        <span>{{ page.page }} / {{ page.pages }}</span>
                        {% if page.hasNext %}<a rel="next" href="{{ path('customer_account_orders', {page: page.page + 1}) }}" aria-label="Sonraki sayfa">›</a>{% endif %}
                    </nav>
                {% endif %}
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}
