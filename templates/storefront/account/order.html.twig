{% extends 'storefront/base.html.twig' %}

{% block title %}Sipariş {{ order.orderNumber }} | {{ store.name }}{% endblock %}

{% block body %}
<main id="main-content" class="page-shell" tabindex="-1">
    <div class="container">
        {% include 'storefront/account/_nav.html.twig' %}
        <nav class="breadcrumbs" aria-label="Sayfa yolu">
            <a href="{{ path('app_home') }}">Ana sayfa</a><span aria-hidden="true">/</span><a href="{{ path('customer_account_orders') }}">Siparişlerim</a><span aria-hidden="true">/</span><span>{{ order.orderNumber }}</span>
        </nav>

        <section class="account-card order-detail" aria-labelledby="order-heading">
            <div class="account-heading order-detail-heading">
                <div>
                    <h1 id="order-heading" class="order-number">{{ order.orderNumber }}</h1>
                    <p class="order-card-date"><time datetime="{{ order.createdAt|date('c') }}">{{ order.createdAt|date('d.m.Y H:i') }}</time></p>
                </div>
                <span class="order-card-state">{{ stateLabel }}</span>
            </div>

            <div class="order-detail-grid">
                <section class="order-detail-products" aria-labelledby="items-heading">
                    <div class="order-section-heading"><h2 id="items-heading">Ürünler</h2><span>{{ summary.lines|length }} ürün · {{ summary.quantity }} adet</span></div>
                    {% include 'storefront/account/_order_products.html.twig' with {lines: summary.lines} only %}
                </section>

                <aside class="order-detail-summary" aria-label="Sipariş özeti">
                    {% if summary.hasPayment %}
                        <section class="order-summary-block" data-testid="payment-summary" aria-labelledby="payment-heading">
                            <h2 id="payment-heading">Ödeme</h2>
                            <dl class="order-summary-list">
                                <dt>Yöntem</dt><dd>{{ summary.paymentMethodLabel }}</dd>
                                <dt>Durum</dt><dd>{{ summary.paymentStatusLabel }}</dd>
                                <dt>Ödenen</dt><dd>{{ summary.capturedAmount|storefront_money }}</dd>
                                {% if summary.hasRefundedAmount %}<dt>İade edilen</dt><dd>{{ summary.refundedAmount|storefront_money }}</dd>{% endif %}
                            </dl>
                        </section>
                    {% else %}
                        <section class="order-summary-block" aria-labelledby="payment-heading">
                            <h2 id="payment-heading">Ödeme</h2>
                            <p>Bu sipariş için henüz ödeme kaydı yok.</p>
                        </section>
                    {% endif %}

                    {% if summary.hasTracking %}
                        {% set tracking = summary.tracking %}
                        <section class="order-summary-block" data-testid="shipment-summary" aria-labelledby="shipment-heading">
                            <h2 id="shipment-heading">Kargo</h2>
                            <dl class="order-summary-list">
                                <dt>Teslimat yöntemi</dt><dd>{{ tracking.methodLabel }}</dd>
                                <dt>Durum</dt><dd>{{ tracking.stateLabel }}</dd>
                                {% if tracking.hasTrackingNumber %}<dt>Takip numarası</dt><dd>{{ tracking.trackingNumber }}</dd>{% endif %}
                            </dl>
                        </section>
                    {% endif %}

                    <section class="order-summary-block" aria-labelledby="totals-heading">
                        <h2 id="totals-heading">Toplamlar</h2>
                        <div class="order-totals">
                            <p><span>Ara toplam</span><strong>{{ order.subtotal|storefront_money }}</strong></p>
                            <p><span>Vergi</span><strong>{{ order.taxTotal|storefront_money }}</strong></p>
                            <p><span>Teslimat</span><strong>{{ order.shippingTotal|storefront_money }}</strong></p>
                            <p class="grand" data-testid="order-total"><span>Genel toplam</span><strong>{{ order.grandTotal|storefront_money }}</strong></p>
                        </div>
                    </section>
                </aside>
            </div>

            <div class="order-addresses">
                {% if order.orderNote is not null %}
                    <section class="order-address-card order-note" data-testid="order-note" aria-labelledby="order-note-heading">
                        <h2 id="order-note-heading">Sipariş notu</h2>
                        <p style="white-space: pre-wrap; overflow-wrap: anywhere">{{ order.orderNote }}</p>
                    </section>
                {% endif %}
                {% if shippingAddress %}
                    <section class="order-address-card" aria-labelledby="shipping-address-heading">
                        <h2 id="shipping-address-heading">Teslimat Adresi</h2>
                        <p class="order-address-recipient">{{ shippingAddress.recipientName }}</p>
                        <p>{{ shippingAddress.addressLine1 }}{% if shippingAddress.addressLine2 %}, {{ shippingAddress.addressLine2 }}{% endif %}</p>
                        <p>{{ shippingAddress.district }} / {{ shippingAddress.city }}{% if shippingAddress.postalCode %} {{ shippingAddress.postalCode }}{% endif %}</p>
                        <p>{{ shippingAddress.phone }}</p>
                    </section>
                {% endif %}
                {% if billingAddress %}
                    <section class="order-address-card" aria-labelledby="billing-address-heading">
                        <h2 id="billing-address-heading">Fatura Adresi</h2>
                        <p class="order-address-recipient">{{ billingAddress.recipientName }}</p>
                        <p>{{ billingAddress.addressLine1 }}{% if billingAddress.addressLine2 %}, {{ billingAddress.addressLine2 }}{% endif %}</p>
                        <p>{{ billingAddress.district }} / {{ billingAddress.city }}{% if billingAddress.postalCode %} {{ billingAddress.postalCode }}{% endif %}</p>
                        <p>{{ billingAddress.phone }}</p>
                    </section>
                {% endif %}
            </div>

            {% if cancellable %}
                <section class="order-return-area" aria-labelledby="cancel-heading">
                    <h2 id="cancel-heading">Sipariş iptali</h2>
                    <form method="post" action="{{ path('customer_account_order_cancel', {orderNumber: order.orderNumber}) }}" data-controller="order-cancel" data-action="submit->order-cancel#confirm">
                        <input type="hidden" name="_token" value="{{ csrf_token('customer_order_cancel_' ~ order.orderNumber) }}">
                        <button class="account-primary-link" type="submit" data-testid="order-cancel">Siparişi İptal Et</button>
                    </form>
                </section>
            {% elseif order.state.value in ['placed', 'confirmed'] %}
                <p class="account-alert">Kargoya hazırlanmış siparişiniz için aşağıdaki iade işlemlerini kullanabilir veya <a href="{{ path('storefront_contact') }}">destek ile iletişime geçebilirsiniz</a>.</p>
            {% endif %}

            <section class="order-return-area" aria-labelledby="returns-heading">
                <h2 id="returns-heading">İade işlemleri</h2>
                {% if returns is not empty %}
                    <h3>Bu siparişin iadeleri</h3>
                    <ul class="order-card-lines">
                        {% for item in returns %}
                            <li><span>{{ item.returnNumber }}<small>{{ item.createdAt|date('d.m.Y') }}</small></span><strong>{{ item.state.value }}</strong></li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if returnable %}
                    <a class="account-primary-link" href="{{ path('customer_account_order_return', {orderNumber: order.orderNumber}) }}">İade talebi oluştur</a>
                {% elseif returnIneligibility is not null %}
                    <p class="account-alert">{{ returnIneligibility.customerMessage }}</p>
                {% endif %}
            </section>
        </section>
    </div>
</main>
{% endblock %}
