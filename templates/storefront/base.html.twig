<!doctype html>
<html lang="{{ store.locale|default('tr') }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#092a53">
        {# `seo` is the single source of the title for every page that resolves its own
           metadata. The block remains so a page with no metadata of its own still gets a
           sensible title instead of an empty one. The `is defined` test is explicit because
           the suite runs with Twig's strict_variables, which rejects `seo.title` on a page
           that never assigned it. #}
        <title>{% block title %}{{ seo is defined and seo ? seo.title : (store.name|default('Efe Otomotiv Adana')) }}{% endblock %}</title>
        {% if seo is defined and seo %}
            {# One canonical per page, built from this store's own route. A canonical that
               changed with the Host header would be worse than none at all. #}
            <meta name="description" content="{{ seo.description }}">
            <link rel="canonical" href="{{ seo.canonicalUrl }}">
            {% if seo.robots %}<meta name="robots" content="{{ seo.robots }}">{% endif %}
            <meta property="og:type" content="{{ seo.type }}">
            <meta property="og:site_name" content="{{ seo.siteName }}">
            <meta property="og:locale" content="{{ seo.locale|replace({'-': '_'}) }}">
            <meta property="og:title" content="{{ seo.title }}">
            <meta property="og:description" content="{{ seo.description }}">
            <meta property="og:url" content="{{ seo.canonicalUrl }}">
            {% if seo.imageUrl %}
                <meta property="og:image" content="{{ seo.imageUrl }}">
                <meta name="twitter:card" content="summary_large_image">
            {% else %}
                <meta name="twitter:card" content="summary">
            {% endif %}
            {# Already JSON-encoded with HTML-sensitive characters escaped, so a product name
               cannot close this element. Autoescaping is deliberately NOT applied here. #}
            {% for graph in seo.jsonLd %}<script type="application/ld+json">{{ graph|raw }}</script>{% endfor %}
        {% endif %}
        {# The typeface the stylesheet below declares, asked for before the stylesheet has been
           parsed. Without this the browser discovers the font only after the CSS arrives and
           paints the page in the fallback first; with it, one request starts earlier. Only the
           `latin` subset is preloaded because that is the subset every page's own copy uses. #}
        <link rel="preload" href="{{ asset('fonts/inter-tight-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ asset('styles/storefront.css') }}" data-storefront-stylesheet>
        <style data-storefront-colors>
            :root {
                {% for name, color in storefront_colors() %}
                --storefront-{{ name }}: {{ color }};
                {% endfor %}
            }
        </style>
        {% block javascripts %}{{ importmap('app') }}{% endblock %}
        {% block analytics %}
        {% set ga4MeasurementId = storefront_ga4_measurement_id() %}
        {% if ga4MeasurementId %}
            <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4MeasurementId }}"></script>
            <script data-storefront-analytics>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', '{{ ga4MeasurementId|escape('js') }}');
            </script>
        {% endif %}
        {% endblock %}
        {# This executable snippet is explicitly managed by authenticated administrators in
           Çerez Politikası. Customer content and order notes never use this raw output path. #}
        {% set cookieScript = storefront_cookie_script() %}
        {% if cookieScript %}{{ cookieScript|raw }}{% endif %}
    </head>
<body class="storefront-page" data-controller="storefront-shell">
        <a class="skip-link" href="#main-content">İçeriğe geç</a>
        {# The theme's notice band sits above the header, at the very top of the page, and there is
           only ever one of them. A page that has no CMS announcement keeps the store's own line;
           the homepage overrides this block with whatever the administrator wrote. #}
        {% block notice %}{% include 'storefront/layout/_notice.html.twig' with {text: 'Adana\'dan Türkiye\'nin her yerine güvenli gönderim'} only %}{% endblock %}
        {% include 'storefront/layout/_header.html.twig' %}

    <div class="storefront-content">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="storefront-flash storefront-flash-{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

    </div>

        {% include 'storefront/layout/_footer.html.twig' %}
    </body>
</html>
