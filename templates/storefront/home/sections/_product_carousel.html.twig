{% if section.data.products %}<section class="container home-section section-card" aria-label="{{ section.title }}"><div class="section-heading"><div><h2>{{ section.title }}</h2>{% if section.subtitle %}<p>{{ section.subtitle }}</p>{% endif %}</div><a href="{{ path('storefront_catalog_index') }}">Tüm ürünler</a></div><div class="product-grid home-product-grid">{% for product in section.data.products %}{% include 'components/product_card.html.twig' with {product: product} only %}{% endfor %}</div></section>{% endif %}
