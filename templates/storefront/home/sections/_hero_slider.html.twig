{# The theme's centre column: a real slider with previous/next controls and a position counter.

   A slide is one of the reference's own three compositions. Two of them stack a label, a headline
   and an offer pill; the third — the one the theme marks `mobile-feature` — carries a pair of calls
   to action instead of a pill, and its content sits to the left over a full-bleed photograph. Both
   come from the same nine fields, so the composition is the content's own shape rather than a
   separate section type. #}
{% if section.data.slides %}
    {% set total = section.data.slides|length %}
    <section class="hero" aria-roledescription="carousel" aria-label="{{ section.title }}" data-controller="home-slider">
        <span class="hero-marker" aria-hidden="true"></span>
        {% for slide in section.data.slides %}
            {% set dimensions = image_dimensions(slide.image) %}
            {% set feature = slide.secondaryText is not empty or slide.secondaryLink is not empty %}
            <div class="hero-slide{% if loop.first %} active{% else %} alt{% endif %}{% if feature %} mobile-feature{% endif %}"
                 data-home-slider-target="slide"
                 role="group"
                 aria-roledescription="slayt"
                 aria-label="{{ loop.index }}/{{ total }}"
                 {% if not loop.first %}aria-hidden="true" tabindex="-1"{% endif %}>
                {# The headline beside the image already states what the slide is, so the image
                   carries no alt text of its own. Only the first slide is fetched eagerly: five
                   equally-weighted candidates for the largest contentful paint would make the
                   browser download images the visitor may never reach. #}
                <img class="hero-photo" src="{{ media_url(slide.image) }}" alt=""{% if dimensions %} width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %}{% if loop.first %} fetchpriority="high" decoding="async"{% else %} loading="lazy" decoding="async"{% endif %}>
                <div class="hero-content">
                    {% if slide.label %}<div class="hero-label">{{ slide.label }}</div>{% endif %}
                    {% if slide.title %}
                        {% if loop.first %}
                            <h1 class="hero-title">{{ slide.title }}</h1>
                        {% else %}
                            <h2 class="hero-title">{{ slide.title }}</h2>
                        {% endif %}
                    {% endif %}
                    {% if slide.priceLabel or slide.priceValue %}
                        <div class="price-pill">
                            {% if slide.priceLabel %}<span>{{ slide.priceLabel }}</span>{% endif %}
                            <strong>{{ slide.priceValue }}</strong>
                        </div>
                    {% endif %}
                    {% if slide.primaryText or slide.primaryLink or slide.secondaryText or slide.secondaryLink %}
                        {# The whole slide is the unit a keyboard user moves through, so the links
                           inside a hidden slide are kept out of the tab order rather than offered
                           and then hidden. #}
                        <div class="hero-actions">
                            {% if slide.primaryText or slide.primaryLink %}
                                <a class="shop-now" href="{{ slide.primaryLink }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ slide.primaryText }}</a>
                            {% endif %}
                            {% if slide.secondaryText or slide.secondaryLink %}
                                <a class="learn-more" href="{{ slide.secondaryLink }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ slide.secondaryText }}</a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        {% if 1 < total %}
            <div class="slider-controls">
                <button class="slider-btn" type="button" data-action="home-slider#next" aria-label="Sonraki slayt">›</button>
                <span class="slide-count" data-home-slider-target="count" aria-live="polite">1/{{ total }}</span>
                <button class="slider-btn prev" type="button" data-action="home-slider#previous" aria-label="Önceki slayt">‹</button>
            </div>
        {% endif %}
    </section>
{% endif %}
