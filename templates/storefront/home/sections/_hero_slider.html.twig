{# The theme's centre column: a real slider with previous/next controls and a position counter. #}
{% if section.data.slides %}
    {% set total = section.data.slides|length %}
    <section class="hero" aria-roledescription="carousel" aria-label="{{ section.title }}" data-controller="home-slider">
        <span class="hero-marker" aria-hidden="true"></span>
        {% for slide in section.data.slides %}
            {% set dimensions = image_dimensions(slide.image) %}
            <div class="hero-slide{% if loop.first %} active{% endif %}"
                 data-home-slider-target="slide"
                 role="group"
                 aria-roledescription="slayt"
                 aria-label="{{ loop.index }}/{{ total }}"
                 {% if not loop.first %}aria-hidden="true" tabindex="-1"{% endif %}>
                {# The headline beside the image already states what the slide is, so the image
                   carries no alt text of its own. Only the first slide is fetched eagerly: five
                   equally-weighted candidates for the largest contentful paint would make the
                   browser download images the visitor may never reach. #}
                <img class="hero-photo" src="{{ media_url(slide.image) }}" alt=""{% if dimensions %} width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %}{% if loop.first %} fetchpriority="high" decoding="async"{% else %} loading="lazy" decoding="async"{% endif %}>
                <div class="hero-content">
                    <div class="hero-label">{{ section.title }}</div>
                    {% if loop.first %}
                        <h1 class="hero-title">{{ slide.title }}</h1>
                    {% else %}
                        <h2 class="hero-title">{{ slide.title }}</h2>
                    {% endif %}
                    {% if slide.description %}<p class="hero-description">{{ slide.description }}</p>{% endif %}
                    <div class="hero-actions">
                        {# The whole slide is the unit a keyboard user moves through, so the link
                           inside a hidden slide is kept out of the tab order rather than offered
                           and then hidden. #}
                        <a class="shop-now" href="{{ slide.link }}"{% if not loop.first %} tabindex="-1"{% endif %}>Keşfet</a>
                    </div>
                </div>
            </div>
        {% endfor %}
        {% if 1 < total %}
            <div class="slider-controls">
                <button class="slider-btn" type="button" data-action="home-slider#next" aria-label="Sonraki slayt">›</button>
                <span class="slide-count" data-home-slider-target="count" aria-live="polite">1/{{ total }}</span>
                <button class="slider-btn prev" type="button" data-action="home-slider#previous" aria-label="Önceki slayt">‹</button>
            </div>
        {% endif %}
    </section>
{% endif %}
