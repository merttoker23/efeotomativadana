{% if section.data.brands %}<section class="container home-section section-card" aria-label="{{ section.title }}"><h2>{{ section.title }}</h2><div class="cms-link-grid">{% for brand in section.data.brands %}<a href="{{ path('storefront_catalog_brand', {slug: brand.slug}) }}">{{ brand.name }}</a>{% endfor %}</div></section>{% endif %}
