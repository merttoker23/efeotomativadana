{% if section.data.banners %}<section class="container home-section section-card" aria-label="{{ section.title }}"><h2>{{ section.title }}</h2><div class="cms-banner-grid">{% for banner in section.data.banners %}<a href="{{ banner.link }}"><img src="{{ media_url(banner.image) }}" alt="{{ banner.title }}" loading="lazy"><strong>{{ banner.title }}</strong></a>{% endfor %}</div></section>{% endif %}
