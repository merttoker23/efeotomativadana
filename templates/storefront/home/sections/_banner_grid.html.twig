{# The theme's promotional row: a strip of image banners under the upper band. #}
{% if section.data.banners %}
    <div class="container home-section promo-grid">
        {% for banner in section.data.banners %}
            {% set dimensions = image_dimensions(banner.image) %}
            <a class="promo-card" href="{{ banner.link }}">
                <img src="{{ media_url(banner.image) }}" alt="{{ banner.title }}"{% if dimensions %} width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %} loading="lazy" decoding="async">
            </a>
        {% endfor %}
    </div>
{% endif %}
