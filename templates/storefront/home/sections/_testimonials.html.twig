{# The theme's customer quotes, the left half of the homepage's lower band. #}
{% if section.data.quotes %}
    <div class="quote">
        <h2>{{ section.title }}</h2>
        {% for quote in section.data.quotes %}
            <figure class="quote-item">
                <blockquote>
                    <p>{{ quote.text }}</p>
                </blockquote>
                <figcaption>{{ quote.author }}</figcaption>
            </figure>
        {% endfor %}
    </div>
{% endif %}
