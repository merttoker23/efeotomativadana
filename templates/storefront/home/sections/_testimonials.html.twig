{% if section.data.quotes %}<section class="container home-section section-card" aria-label="{{ section.title }}"><h2>{{ section.title }}</h2><div class="cms-quote-grid">{% for quote in section.data.quotes %}<blockquote><p>{{ quote.text }}</p><footer>{{ quote.author }}</footer></blockquote>{% endfor %}</div></section>{% endif %}
