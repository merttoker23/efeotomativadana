{% if section.data.posts %}<section class="container home-section section-card" aria-label="{{ section.title }}"><div class="section-heading"><h2>{{ section.title }}</h2><a href="{{ path('storefront_blog_index') }}">Tüm yazılar</a></div><div class="cms-blog-grid">{% for post in section.data.posts %}<article><h3><a href="{{ path('storefront_blog_show', {slug: post.slug}) }}">{{ post.title }}</a></h3><p>{{ post.excerpt }}</p></article>{% endfor %}</div></section>{% endif %}
