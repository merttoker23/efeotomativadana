{# The theme's blog feed, the right half of the homepage's lower band. #}
{% if section.data.posts %}
    <div class="section-card">
        <div class="section-head">
            <h2>{{ section.title }}</h2>
            <a class="see-all" href="{{ path('storefront_blog_index') }}">Blog</a>
        </div>
        <div class="blog-grid">
            {% for post in section.data.posts %}
                <a class="blog-card" href="{{ path('storefront_blog_show', {slug: post.slug}) }}">
                    <span class="blog-cover{{ post.coverImagePath ? ' blog-cover-image' : '' }}" aria-hidden="true">{% if post.coverImagePath %}<img src="{{ media_url(post.coverImagePath) }}" alt="" loading="lazy" decoding="async">{% endif %}</span>
                    <span class="content">
                        <h3>{{ post.title }}</h3>
                        <p>{{ post.excerpt }}</p>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
{% endif %}
