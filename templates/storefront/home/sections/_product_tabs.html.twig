{% for tab in section.data.tabs %}{% if tab.products %}<section class="container home-section section-card" aria-label="{{ tab.title }}"><h2>{{ section.title }} — {{ tab.title }}</h2><div class="product-grid home-product-grid">{% for product in tab.products %}{% include 'components/product_card.html.twig' with {product: product} only %}{% endfor %}</div></section>{% endif %}{% endfor %}
