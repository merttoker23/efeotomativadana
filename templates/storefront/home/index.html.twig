{% extends 'storefront/base.html.twig' %}

{% block title %}{{ store.name }} | Otomotiv Yedek Parça{% endblock %}

{% block body %}
<main id="main-content" class="page-shell">
    {% if sections %}
        <h1 class="container cms-home-title">Otomotiv parçasında güvenilir adresiniz</h1>
        {% for section in sections %}
            {% include section.template with {section: section} only %}
        {% endfor %}
    {% else %}
        <section class="container home-top" aria-labelledby="home-title">
            <div class="hero-panel">
                <div class="hero-copy">
                    <p class="hero-eyebrow">{{ store.name }}</p>
                    <h1 id="home-title">Otomotiv parçasında güvenilir adresiniz</h1>
                    <p>Aracınız için doğru yedek parçayı keşfedin.</p>
                    <a class="hero-cta" href="{{ path('storefront_catalog_index') }}">Ürün kataloğunu incele</a>
                </div>
                <img class="hero-image" src="{{ asset('storefront/images/hero-automotive.svg') }}" alt="Otomotiv yedek parça vitrini">
            </div>
        </section>
    {% endif %}
</main>
{% endblock %}
