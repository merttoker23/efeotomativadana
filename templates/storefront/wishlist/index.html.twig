{% extends 'storefront/base.html.twig' %}

{% block title %}İstek Listem | {{ store.name }}{% endblock %}

{% block body %}
<main id="main-content" class="page-shell" tabindex="-1">
    <section class="container selection-page-card">
        <h1>İstek Listem</h1>
        <p class="wishlist-summary">{{ page.total }} ürün · Sayfa {{ page.page }} / {{ page.pages }}</p>
        {% if page.total == 0 %}
            <div class="cart-empty"><p>İstek listeniz boş.</p><a class="account-primary-link" href="{{ path('storefront_catalog_index') }}">Ürünleri incele</a></div>
        {% elseif page.items is empty %}
            <p>Bu sayfada ürün bulunamadı. <a href="{{ path('storefront_wishlist_index', {page: 1}) }}">İlk sayfaya dön</a></p>
        {% else %}
            <div class="selection-grid">
                {% for item in page.items %}
                    <article class="wishlist-item selection-card">
                        <img src="{{ product_image_url(item.imagePath) }}" alt="{{ item.name }}" width="640" height="640" loading="lazy" decoding="async">
                        <div><a href="{{ path('storefront_catalog_product', {slug: item.slug}) }}"><strong>{{ item.name }}</strong></a><small>{{ item.sku }}</small></div>
                        <p>{{ item.price ? item.price|storefront_money : 'Fiyat için iletişime geçin' }}</p>
                        <span class="stock-state {{ item.sellable ? 'is-available' : 'is-unavailable' }}">{{ item.sellable ? 'Stokta' : 'Stokta yok' }}</span>
                        <form class="wishlist-remove-form" method="post" action="{{ path('storefront_wishlist_remove', {id: item.selectionId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('wishlist_remove') }}">
                            <button type="submit">Listeden kaldır</button>
                        </form>
                    </article>
                {% endfor %}
            </div>
            {% if page.pages > 1 %}
                <nav class="pagination" aria-label="İstek listesi sayfaları">
                    {% if page.hasPrevious %}<a href="{{ path('storefront_wishlist_index', {page: page.page - 1}) }}" rel="prev">Önceki</a>{% endif %}
                    <span aria-current="page">{{ page.page }}</span>
                    {% if page.hasNext %}<a href="{{ path('storefront_wishlist_index', {page: page.page + 1}) }}" rel="next">Sonraki</a>{% endif %}
                </nav>
            {% endif %}
        {% endif %}
    </section>
</main>
{% endblock %}
