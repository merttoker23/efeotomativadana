{# Shared shell for every transactional mail.

   Kept deliberately plain: a mail client is the worst renderer in the product, so this uses
   tables and inline styles rather than the theme's flexbox classes, and no external stylesheet
   or image, because an image a client refuses to fetch is a logo that silently disappears. #}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#eef1f5;font-family:Arial,Helvetica,sans-serif;color:#12233a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef1f5;padding:24px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #dfe4ea;">
                <tr>
                    <td style="background:#092a53;padding:20px 28px;">
                        <span style="color:#ffffff;font-size:18px;font-weight:bold;">Efe Otomotiv Adana</span>
                    </td>
                </tr>
                <tr>
                    <td style="padding:28px;">
                        <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#092a53;">{{ subject }}</h1>
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:20px 28px;background:#f6f8fa;border-top:1px solid #e7ebef;color:#66717d;font-size:12px;line-height:1.6;">
                        <p style="margin:0 0 8px;">Bu mesajı <strong>{{ recipient|default('müşterilerimiz') }}</strong> adına gönderiyoruz.</p>
                        <p style="margin:0;">Siparişinizle ilgili sorularınız için <a href="mailto:info@efeotomotivadana.com.tr" style="color:#092a53;">info@efeotomotivadana.com.tr</a> adresine yazabilirsiniz.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
