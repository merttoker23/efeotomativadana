<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>Administrator sign in | Efe Otomotiv Adana</title>
        <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    </head>
    <body class="admin-login-page">
        <main class="login-card">
            <p class="eyebrow">Efe Otomotiv Adana</p>
            <h1>Administrator sign in</h1>

            {% if error %}
                <div class="alert alert-error" role="alert">The email or password is incorrect.</div>
            {% endif %}

            <form method="post" action="{{ path('admin_login') }}">
                <label for="username">Email</label>
                <input id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="username" required autofocus>

                <label for="password">Password</label>
                <input id="password" name="_password" type="password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit">Sign in</button>
            </form>
        </main>
    </body>
</html>
