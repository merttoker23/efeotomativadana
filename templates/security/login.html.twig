<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>Yönetici girişi | Efe Otomotiv Adana</title>
        <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    </head>
    <body class="admin-login-page">
        <main class="login-card">
            <div class="brand-mark" aria-hidden="true">EO</div>
            <p class="eyebrow">Efe Otomotiv Adana</p>
            <h1>Yönetici girişi</h1>

            {% if error %}
                <div class="alert alert-error" role="alert">E-posta veya şifre hatalı.</div>
            {% endif %}

            <form method="post" action="{{ path('admin_login') }}">
                <label for="username">E-posta</label>
                <input id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="username" required>

                <label for="password">Şifre</label>
                <input id="password" name="_password" type="password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit">Giriş yap</button>
            </form>
        </main>
    </body>
</html>
