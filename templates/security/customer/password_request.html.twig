{% extends 'storefront/base.html.twig' %}

{% block title %}Parolamı unuttum | {{ store.name }}{% endblock %}

{% block body %}
    <main id="main-content" class="page-shell">
        <div class="container">
            <nav class="breadcrumbs" aria-label="Sayfa yolu">
                <a href="{{ path('app_home') }}">Ana sayfa</a><span aria-hidden="true">/</span><span>Parolamı unuttum</span>
            </nav>
            <section class="account-card account-card-narrow" aria-labelledby="password-request-heading">
                <p class="panel-kicker">Hesap kurtarma</p>
                <h1 id="password-request-heading">Parolanızı sıfırlayın</h1>
                <p class="account-intro">Hesabınız varsa e-posta adresinize tek kullanımlık bir bağlantı göndeririz.</p>
                {{ form_start(password_request_form, {attr: {class: 'account-form'}}) }}
                    {{ form_row(password_request_form.email) }}
                    {{ form_row(password_request_form.request, {attr: {class: 'account-primary-button'}}) }}
                {{ form_end(password_request_form) }}
            </section>
        </div>
    </main>
{% endblock %}
