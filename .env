# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Docker (compose.yaml) varsayılanı: database servisi, MySQL 8.4
DATABASE_URL="mysql://app:!ChangeMe!@database:3306/app?serverVersion=8.4&charset=utf8mb4"
# Docker'suz yerel koşum için:
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.4&charset=utf8mb4"
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> efe/b2b ###
EFE_B2B_FEED_URL=https://b2b.efeotoyedekparca.com.tr/json-tum-gercek-stoklar.php
EFE_B2B_ALLOWED_HOSTS=b2b.efeotoyedekparca.com.tr
EFE_B2B_CA_BUNDLE=
EFE_B2B_SNAPSHOT_DIR=var/b2b-snapshots
EFE_B2B_PRODUCT_MEDIA_DIR=public/uploads/products
###< efe/b2b ###

###> paytr ###
# Card payments run through PayTR's Direct API, where the customer's browser posts the card form
# straight to PayTR. No card data ever reaches this application, so no route here can accept one.
#
# The three credentials below come from the PayTR merchant panel
# (Mağaza Paneli > Destek & Kurulum > Entegrasyon Bilgileri) and MUST be entered in the
# uncommitted .env.local, never here. Until all three are present the provider reports itself as
# not ready and the store stops offering card payment.
#
# PAYTR_TEST_MODE=1 makes the store send PayTR's own test switch, so transactions are exercised
# without real money. Set it to 0 only once the merchant panel is switched to live mode.
#
# The Bildirim URL registered in that same panel must be <public base>/yeni/odeme/paytr/bildirim.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_PAYMENT_URL=https://www.paytr.com/odeme
PAYTR_REFUND_URL=https://www.paytr.com/odeme/iade
###< paytr ###
