<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         defaultTestSuite="fast"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <!-- The container's CLI default is 128M, which the full suite reached within ~10% of and
             then exhausted on one run: a whole-branch suite holds every Doctrine entity and
             DomCrawler it ever built. A raised ceiling makes the gate deterministic instead of
             occasionally green and occasionally a fatal error. -->
        <ini name="memory_limit" value="512M" />
        <env name="APP_ENV" value="test" force="true" />
        <server name="APP_ENV" value="test" force="true" />
        <!-- Payment providers are handed absolute return URLs built from this base. Tests use
             https so no test can pass on an address production would refuse. -->
        <env name="DEFAULT_URI" value="https://localhost" force="true" />
        <server name="DEFAULT_URI" value="https://localhost" force="true" />
        <!-- Deterministic test credentials also override blank Docker environment values. -->
        <env name="PAYTR_MERCHANT_ID" value="123456" force="true" />
        <server name="PAYTR_MERCHANT_ID" value="123456" force="true" />
        <env name="PAYTR_MERCHANT_KEY" value="test-merchant-key" force="true" />
        <server name="PAYTR_MERCHANT_KEY" value="test-merchant-key" force="true" />
        <env name="PAYTR_MERCHANT_SALT" value="test-merchant-salt" force="true" />
        <server name="PAYTR_MERCHANT_SALT" value="test-merchant-salt" force="true" />
        <env name="PAYTR_TEST_MODE" value="1" force="true" />
        <server name="PAYTR_TEST_MODE" value="1" force="true" />
        <env name="DATABASE_URL" value="mysql://app:!ChangeMe!@database:3306/app?serverVersion=8.4&amp;charset=utf8mb4" force="true" />
        <server name="DATABASE_URL" value="mysql://app:!ChangeMe!@database:3306/app?serverVersion=8.4&amp;charset=utf8mb4" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="fast">
            <directory>tests/Unit</directory>
            <directory>tests/Module</directory>
            <directory>tests/Configuration</directory>
            <directory>tests/EventListener</directory>
        </testsuite>

        <testsuite name="integration">
            <directory>tests/Controller</directory>
            <directory>tests/Integration</directory>
        </testsuite>

        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>

        <testsuite name="slow">
            <directory>tests/Performance</directory>
            <file>tests/Contract/B2b/Efe/EfeLargeFeedMemoryTest.php</file>
            <file>tests/Security/RateLimitTest.php</file>
            <file>tests/Command/CreateAdminUserCommandTest.php</file>
            <file>tests/Contract/B2b/Efe/EfeFeedProviderTest.php</file>
            <file>tests/Contract/B2b/Efe/EfeSnapshotDownloaderTest.php</file>
            <file>tests/Contract/Payment/PayTR/PaytrNotificationAndRefundTest.php</file>
        </testsuite>

        <testsuite name="full">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
    </extensions>
</phpunit>
